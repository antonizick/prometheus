#!/usr/bin/env python3
"""prometheusd — the Prometheus speech broker.

Exactly one process opens the audio device (ADR-0001). Everything else submits
fire-and-forget JSON speech intents to $XDG_RUNTIME_DIR/prometheus/sock and
forgets about them.

Resource contract (docs/07-resource-profile.md): no polling anywhere. Every
thread blocks on a socket read, an inotify read, a pipe read, or a condition
variable. The only timed wait is the speaker's wait-until-next-TTL-deadline,
which wakes at most once per queued intent.

Stdlib only. No third-party dependencies.
"""

from __future__ import annotations

import collections
import ctypes
import errno
import heapq
import json
import os
import re
import selectors
import signal
import socket
import struct
import subprocess
import sys
import threading
import time

# --------------------------------------------------------------------------
# Paths
# --------------------------------------------------------------------------

HOME = os.path.expanduser("~")
RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
CONFIG_DIR = os.environ.get("PROMETHEUS_CONFIG_DIR") or os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or f"{HOME}/.config", "prometheus"
)
STATE_DIR = os.environ.get("PROMETHEUS_STATE_DIR") or os.path.join(
    os.environ.get("XDG_STATE_HOME") or f"{HOME}/.local/state", "prometheus"
)
SOCK_DIR = os.path.join(RUNTIME_DIR, "prometheus")
SOCK_PATH = os.path.join(SOCK_DIR, "sock")
# Overridable so the mic gate can be exercised without writing to a live
# voxtype's published state file.
VOXTYPE_DIR = os.environ.get("PROMETHEUS_VOXTYPE_DIR") or os.path.join(RUNTIME_DIR, "voxtype")
VOXTYPE_STATE = os.path.join(VOXTYPE_DIR, "state")

CONFIG_FILE = os.path.join(CONFIG_DIR, "config.json")
ENABLED_FILE = os.path.join(STATE_DIR, "enabled")
VERBOSITY_FILE = os.path.join(STATE_DIR, "verbosity")

SAMPLE_RATE = 22050
BYTES_PER_SAMPLE = 2

PRIORITIES = ("critical", "normal", "ambient", "debug")
PRIORITY_RANK = {p: i for i, p in enumerate(PRIORITIES)}
VERBOSITIES = ("quiet", "normal", "chatty")

# --------------------------------------------------------------------------
# Logging
# --------------------------------------------------------------------------
#
# Two sinks, independently levelled:
#
#   stderr  — human-readable, captured by systemd into the journal.
#             `prometheus log -f` tails it.
#   file    — newline-delimited JSON at ~/.local/state/prometheus/prometheusd.log,
#             rotated. Structured, so it can be queried with jq when tuning
#             what should and shouldn't be spoken.
#
# Every intent gets an id and is logged at each step of its life: received,
# accepted or dropped with the reason, then spoken with timings or interrupted.
# When something doesn't speak, the log says which gate stopped it.

LEVELS = {"debug": 10, "info": 20, "warn": 30, "error": 40}
LEVEL_NAME = {v: k for k, v in LEVELS.items()}
TRACE_FIELDS = ("id", "priority", "category", "reason")


class Log:
    def __init__(self) -> None:
        self.level = LEVELS["info"]
        self.file_level = LEVELS["debug"]
        self.file_path: str | None = None
        self.max_bytes = 4 * 1024 * 1024
        self._fh = None
        self._lock = threading.Lock()

    def configure(self, cfg: dict) -> None:
        lg = cfg.get("logging", {})
        self.level = LEVELS.get(cfg.get("log_level", "info"), LEVELS["info"])
        self.file_level = LEVELS.get(lg.get("file_level", "debug"), LEVELS["debug"])
        self.max_bytes = int(lg.get("max_bytes", 4 * 1024 * 1024))
        want = os.path.join(STATE_DIR, "prometheusd.log") if lg.get("file_enabled", True) else None
        with self._lock:
            if want != self.file_path:
                if self._fh:
                    self._fh.close()
                    self._fh = None
                self.file_path = want
                self._open_locked()

    def _open_locked(self) -> None:
        if not self.file_path:
            return
        try:
            os.makedirs(os.path.dirname(self.file_path), exist_ok=True)
            self._fh = open(self.file_path, "a", buffering=1)
        except OSError:
            self._fh = None

    def _rotate_locked(self) -> None:
        if not (self._fh and self.file_path):
            return
        try:
            if self._fh.tell() < self.max_bytes:
                return
            self._fh.close()
            os.replace(self.file_path, self.file_path + ".1")
            self._open_locked()
        except OSError:
            self._fh = None

    def emit(self, level: str, event: str, msg: str = "", **fields) -> None:
        lv = LEVELS[level]
        if lv < self.level and lv < self.file_level:
            return
        now = time.time()
        if lv >= self.level:
            parts = [f"{k}={v}" for k, v in fields.items() if v is not None]
            line = f"{time.strftime('%H:%M:%S', time.localtime(now))}." \
                   f"{int(now % 1 * 1000):03d} {level.upper():<5} {event}"
            if msg:
                line += f": {msg}"
            if parts:
                line += "  " + " ".join(parts)
            print(line, file=sys.stderr, flush=True)
        if lv >= self.file_level and self._fh:
            rec = {"t": round(now, 3), "level": level, "event": event}
            if msg:
                rec["msg"] = msg
            rec.update({k: v for k, v in fields.items() if v is not None})
            with self._lock:
                if self._fh:
                    try:
                        self._fh.write(json.dumps(rec, default=str) + "\n")
                        self._rotate_locked()
                    except OSError:
                        pass

    def debug(self, event, msg="", **f): self.emit("debug", event, msg, **f)
    def info(self, event, msg="", **f): self.emit("info", event, msg, **f)
    def warn(self, event, msg="", **f): self.emit("warn", event, msg, **f)
    def error(self, event, msg="", **f): self.emit("error", event, msg, **f)


LOG = Log()


class Transcript:
    """Everything said to and by the system, in one place.

    ~/.local/state/prometheus/transcript.jsonl — one JSON object per line:

      {"t": ..., "dir": "out", "text": "Build passed.", "voice": "system",
       "priority": "normal", "category": "shell", "status": "spoken", ...}
      {"t": ..., "dir": "in",  "text": "run the tests", "source": "voxtype"}

    "out" is what Prometheus said (and, at debug level, what it decided not to
    say and why). "in" is what was dictated at it. Kept separate from the
    daemon log because this is the record worth reading back — it's the
    evidence base for tuning what should be spoken (docs/04, Phase 1).
    """

    def __init__(self) -> None:
        self.path: str | None = None
        self.log_dropped = True
        self.max_bytes = 4 * 1024 * 1024
        self._fh = None
        self._lock = threading.Lock()

    def configure(self, cfg: dict) -> None:
        tc = cfg.get("transcript", {})
        want = os.path.join(STATE_DIR, "transcript.jsonl") if tc.get("enabled", True) else None
        self.log_dropped = bool(tc.get("include_dropped", True))
        self.max_bytes = int(tc.get("max_bytes", 4 * 1024 * 1024))
        with self._lock:
            if want != self.path:
                if self._fh:
                    self._fh.close()
                    self._fh = None
                self.path = want
                self._open_locked()

    def _open_locked(self) -> None:
        if not self.path:
            return
        try:
            os.makedirs(os.path.dirname(self.path), exist_ok=True)
            self._fh = open(self.path, "a", buffering=1)
        except OSError:
            self._fh = None

    def write(self, direction: str, text: str, **fields) -> None:
        with self._lock:
            if not self._fh:
                return
            rec = {"t": round(time.time(), 3), "dir": direction, "text": text}
            rec.update({k: v for k, v in fields.items() if v is not None})
            try:
                self._fh.write(json.dumps(rec, default=str) + "\n")
                if self._fh.tell() >= self.max_bytes:
                    self._fh.close()
                    os.replace(self.path, self.path + ".1")
                    self._open_locked()
            except OSError:
                pass


TRANSCRIPT = Transcript()


