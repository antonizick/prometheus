def deep_merge(base: dict, over: dict) -> dict:
    out = dict(base)
    for k, v in (over or {}).items():
        if isinstance(v, dict) and isinstance(out.get(k), dict):
            out[k] = deep_merge(out[k], v)
        else:
            out[k] = v
    return out


def strip_jsonc(text: str) -> str:
    """Remove // line comments outside string literals.

    docs/08 documents config.json with comments, so accept them.
    """
    out = []
    in_str = False
    esc = False
    i = 0
    while i < len(text):
        c = text[i]
        if in_str:
            out.append(c)
            if esc:
                esc = False
            elif c == "\\":
                esc = True
            elif c == '"':
                in_str = False
        elif c == '"':
            in_str = True
            out.append(c)
        elif c == "/" and i + 1 < len(text) and text[i + 1] == "/":
            while i < len(text) and text[i] != "\n":
                i += 1
            continue
        else:
            out.append(c)
        i += 1
    return "".join(out)


def load_config() -> dict:
    try:
        with open(CONFIG_FILE, "r") as f:
            raw = json.loads(strip_jsonc(f.read()))
    except FileNotFoundError:
        LOG.info("config.missing", "using built-in defaults", path=CONFIG_FILE)
        return dict(DEFAULT_CONFIG)
    except (OSError, ValueError) as e:
        LOG.error("config.unreadable", str(e), path=CONFIG_FILE)
        return dict(DEFAULT_CONFIG)
    return deep_merge(DEFAULT_CONFIG, raw)


def read_state(path: str, default: str) -> str:
    try:
        with open(path, "r") as f:
            v = f.read().strip()
        return v or default
    except OSError:
        return default


# --------------------------------------------------------------------------
# inotify (ctypes — avoids a resident inotifywait subprocess per watch)
# --------------------------------------------------------------------------

IN_MODIFY = 0x00000002
IN_CLOSE_WRITE = 0x00000008
IN_MOVED_TO = 0x00000080
IN_CREATE = 0x00000100
IN_DELETE = 0x00000200
IN_CLOEXEC = 0o2000000

_EVENT_HDR = struct.Struct("iIII")


class Inotify:
    def __init__(self) -> None:
        self._libc = ctypes.CDLL("libc.so.6", use_errno=True)
        self._libc.inotify_init1.argtypes = [ctypes.c_int]
        self._libc.inotify_add_watch.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_uint32]
        self._libc.inotify_rm_watch.argtypes = [ctypes.c_int, ctypes.c_int]
        fd = self._libc.inotify_init1(IN_CLOEXEC)
        if fd < 0:
            raise OSError(ctypes.get_errno(), "inotify_init1 failed")
        self.fd = fd
        self._watches: dict[int, str] = {}

    def add(self, path: str, mask: int) -> int | None:
        wd = self._libc.inotify_add_watch(self.fd, path.encode(), mask)
        if wd < 0:
            LOG.warn("watch.failed", os.strerror(ctypes.get_errno()), path=path)
            return None
        self._watches[wd] = path
        return wd

    def remove(self, wd: int) -> None:
        self._libc.inotify_rm_watch(self.fd, wd)
        self._watches.pop(wd, None)

    def read_events(self):
        """Block until events arrive; yield (dir_path, name, mask)."""
        data = os.read(self.fd, 8192)
        off = 0
        while off + _EVENT_HDR.size <= len(data):
            wd, mask, _cookie, nlen = _EVENT_HDR.unpack_from(data, off)
            off += _EVENT_HDR.size
            name = data[off : off + nlen].split(b"\0", 1)[0].decode("utf-8", "replace")
            off += nlen
            path = self._watches.get(wd)
            if path is not None:
                yield path, name, mask

    def close(self) -> None:
        try:
            os.close(self.fd)
        except OSError:
            pass


# --------------------------------------------------------------------------
# Warm Piper
# --------------------------------------------------------------------------

_RTF_RE = re.compile(rb"audio=([0-9.]+) sec")


class PiperDied(Exception):
    pass


class Voice:
    """A resident Piper process producing exactly-framed raw PCM.

    Protocol (verified empirically, see experiments/piper-framing.md):
      * Piper logs a cumulative `audio=<seconds>` total to stderr per input line.
      * With --sentence_silence 0 the emitted byte count matches that total
        exactly, so each utterance's PCM length is the cumulative delta.
      * stdout MUST be drained concurrently: Piper blocks on a full stdout pipe
        before it logs, which otherwise deadlocks.
    """

    def __init__(self, name: str, cfg: dict, voice_cfg: dict) -> None:
        self.name = name
        self.binary = os.path.expanduser(cfg["voice"]["binary"])
        self.espeak_data = os.path.expanduser(cfg["voice"]["espeak_data"])
        self.voices_dir = os.path.expanduser(cfg["voice"]["voices_dir"])
        self.model_name = voice_cfg["model"]
        self.length_scale = float(voice_cfg.get("length_scale", 0.7))
        # Piper voices are not all 22050 Hz. The rate drives both the PCM
        # framing maths and paplay's format, so read it from the model's
        # sidecar rather than assuming.
        self.sample_rate = SAMPLE_RATE
        self.proc: subprocess.Popen | None = None
        self._buf = bytearray()
        self._cv = threading.Condition()
        self._rtf: collections.deque[float] = collections.deque()
        self._rtf_cv = threading.Condition()
        self._consumed = 0
        self._alive = False
        self._fail_count = 0
        self._next_try = 0.0

    @property
    def model_path(self) -> str:
        m = self.model_name
        if m and (os.path.sep in m or m.endswith(".onnx")):
            return os.path.expanduser(m)
        return os.path.join(self.voices_dir, f"{m}.onnx")

    def start(self) -> bool:
        if self._alive:
            return True
        now = time.monotonic()
        if now < self._next_try:
            return False
        if not self.model_name:
            return False
        if not os.path.exists(self.model_path):
            LOG.error("voice.model_missing", "voice disabled until the model exists",
                      voice=self.name, path=self.model_path)
            self._backoff()
            return False
        self.sample_rate = self._read_sample_rate()
        argv = [
            self.binary,
            "--model", self.model_path,
            "--json-input",
            "--output_raw",
            "--length_scale", str(self.length_scale),
            # Must be 0: Piper's own sentence padding is excluded from the
            # duration it reports, which would desynchronise PCM framing.
            "--sentence_silence", "0",
            "--espeak_data", self.espeak_data,
        ]
        try:
            self.proc = subprocess.Popen(
                argv,
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                bufsize=0,
            )
        except OSError as e:
            LOG.error("voice.spawn_failed", str(e), voice=self.name, binary=self.binary)
            self._backoff()
            return False

        self._buf.clear()
        self._consumed = 0
        self._rtf.clear()
        self._alive = True
        threading.Thread(target=self._drain_stdout, daemon=True,
                         name=f"piper-out-{self.name}").start()
        threading.Thread(target=self._drain_stderr, daemon=True,
                         name=f"piper-err-{self.name}").start()
        LOG.info("voice.up", "warm piper resident", voice=self.name,
                 model=self.model_name, length_scale=self.length_scale, pid=self.proc.pid)
        return True

    def _read_sample_rate(self) -> int:
        try:
            with open(self.model_path + ".json") as f:
                rate = int(json.load(f)["audio"]["sample_rate"])
            if rate != SAMPLE_RATE:
                LOG.info("voice.sample_rate", "non-default rate for this voice",
                         voice=self.name, rate=rate)
            return rate
        except (OSError, ValueError, KeyError, TypeError):
            return SAMPLE_RATE

    def _backoff(self) -> None:
        self._fail_count += 1
        delay = min(30.0, 0.5 * (2 ** min(self._fail_count, 6)))
        self._next_try = time.monotonic() + delay
        LOG.warn("voice.backoff", f"retrying in {delay:.1f}s", voice=self.name,
                 failures=self._fail_count)

    def _drain_stdout(self) -> None:
        fd = self.proc.stdout.fileno()
        while True:
            try:
                b = os.read(fd, 65536)
            except OSError:
                break
            if not b:
                break
            with self._cv:
                self._buf.extend(b)
                self._cv.notify_all()
        self._mark_dead()

    def _drain_stderr(self) -> None:
        for line in iter(self.proc.stderr.readline, b""):
            m = _RTF_RE.search(line)
            if m:
                with self._rtf_cv:
                    self._rtf.append(float(m.group(1)))
                    self._rtf_cv.notify_all()
            elif b"[error]" in line or b"[warning]" in line:
                LOG.warn("voice.piper_log", line.decode("utf-8", "replace").strip(),
                         voice=self.name)
        self._mark_dead()

    def _mark_dead(self) -> None:
        if self._alive:
            self._alive = False
            LOG.warn("voice.died", "piper exited; will respawn with backoff",
                     voice=self.name)
            self._backoff()
        with self._cv:
            self._cv.notify_all()
        with self._rtf_cv:
            self._rtf_cv.notify_all()

    def synth(self, text: str, timeout: float = 20.0) -> bytes:
        """Synthesize one line of text; return its exact PCM. Serialized by caller."""
        if not self._alive and not self.start():
            raise PiperDied(self.name)
        try:
            self.proc.stdin.write(json.dumps({"text": text}).encode() + b"\n")
            self.proc.stdin.flush()
        except (BrokenPipeError, OSError) as e:
            self._mark_dead()
            raise PiperDied(self.name) from e

        deadline = time.monotonic() + timeout
        with self._rtf_cv:
            while not self._rtf:
                if not self._alive:
                    raise PiperDied(self.name)
                if not self._rtf_cv.wait(timeout=max(0.0, deadline - time.monotonic())):
                    raise PiperDied(self.name)
            cumulative = self._rtf.popleft()

        need = round(cumulative * self.sample_rate) * BYTES_PER_SAMPLE - self._consumed
        if need < 0:
            raise PiperDied(self.name)
        with self._cv:
            while len(self._buf) < need:
                if not self._alive:
                    raise PiperDied(self.name)
                if not self._cv.wait(timeout=max(0.0, deadline - time.monotonic())):
                    raise PiperDied(self.name)
            pcm = bytes(self._buf[:need])
            del self._buf[:need]
        self._consumed += need
        self._fail_count = 0
        return pcm

    def stop(self) -> None:
        self._alive = False
        p = self.proc
        self.proc = None
        if not p:
            return
        try:
            p.stdin.close()
        except OSError:
            pass
        try:
            p.terminate()
            p.wait(timeout=2)
        except Exception:
            try:
                p.kill()
            except Exception:
                pass


# --------------------------------------------------------------------------
# Playback
# --------------------------------------------------------------------------

class Player:
    """One paplay per utterance.

    Piper is what's expensive to start (a 63 MB model load, 0.23 s); paplay
    costs ~15 ms. Keeping paplay per-utterance is what makes an instant stop
    possible at all — there is no way to flush a running paplay's buffer, so
    barge-in means killing it. A shallow --latency-msec keeps the unplayed
    tail short.
    """

    def __init__(self, cfg: dict) -> None:
        self.latency_msec = int(cfg["audio"]["latency_msec"])
        self._proc: subprocess.Popen | None = None
        self._lock = threading.Lock()

    def play(self, pcm: bytes, should_stop: threading.Event,
             rate: int = SAMPLE_RATE) -> bool:
        """Play PCM. Returns True if it finished, False if stopped early."""
        argv = [
            "paplay", "--raw",
            f"--rate={rate}", "--channels=1", "--format=s16le",
            f"--latency-msec={self.latency_msec}",
            "--client-name=prometheus",
        ]
        try:
            proc = subprocess.Popen(argv, stdin=subprocess.PIPE, bufsize=0,
                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError as e:
            LOG.error("audio.spawn_failed", str(e))
            return False

        with self._lock:
            if should_stop.is_set():
                proc.kill()
                proc.wait()
                return False
            self._proc = proc

        # Write straight to the fd: a buffered stdin would try to flush at GC
        # time after a kill and raise BrokenPipeError from the finalizer.
        completed = True
        fd = proc.stdin.fileno()
        try:
            view = memoryview(pcm)
            sent = 0
            while sent < len(view):
                if should_stop.is_set():
                    completed = False
                    break
                sent += os.write(fd, view[sent : sent + 8192])
        except (BrokenPipeError, OSError):
            completed = False
        finally:
            with self._lock:
                self._proc = None
            if not completed and proc.poll() is None:
                try:
                    proc.kill()
                except OSError:
                    pass
            try:
                proc.stdin.close()
            except (BrokenPipeError, OSError):
                pass
            proc.wait()
        return completed and not should_stop.is_set()

    def kill_current(self) -> None:
        with self._lock:
            p = self._proc
            if p and p.poll() is None:
                try:
                    p.kill()
                except OSError:
                    pass


# --------------------------------------------------------------------------
# Intents
# --------------------------------------------------------------------------

_ABBREVS = {
    "mr", "mrs", "ms", "dr", "prof", "st", "ave", "rd", "etc", "vs", "approx",
    "inc", "ltd", "jan", "feb", "mar", "apr", "jun", "jul", "aug", "sep", "oct",
    "nov", "dec", "e.g", "i.e", "no", "fig", "al",
}
_SENT_SPLIT = re.compile(r"(?<=[.!?])[\"')\]]*\s+")


def split_sentences(text: str) -> list[str]:
    """Split for pacing only. Framing stays exact however this splits."""
    parts = _SENT_SPLIT.split(text.strip())
    out: list[str] = []
    for part in parts:
        if not part:
            continue
        if out:
            tail = out[-1].rstrip(".!?\"')]").rsplit(None, 1)
            last_word = tail[-1].lower() if tail else ""
            # Rejoin "Dr." + "Smith ..." and single-initial splits.
            if last_word in _ABBREVS or (len(last_word) == 1 and last_word.isalpha()):
                out[-1] = out[-1] + " " + part
                continue
        out.append(part)
    return out or [text.strip()]


class Intent:
    __slots__ = ("text", "priority", "category", "dedup_key", "ttl_ms", "preempt",
                 "enqueued", "seq", "conn")

    def __init__(self, text, priority, category, dedup_key, ttl_ms, preempt, seq, conn):
        self.text = text
        self.priority = priority
        self.category = category
        self.dedup_key = dedup_key
        self.ttl_ms = ttl_ms
        self.preempt = preempt
        self.enqueued = time.monotonic()
        self.seq = seq
        self.conn = conn  # set only when the producer asked for an ack

    @property
    def deadline(self) -> float | None:
        return self.enqueued + self.ttl_ms / 1000.0 if self.ttl_ms else None

    def expired(self, now: float) -> bool:
        d = self.deadline
        return d is not None and now > d


# --------------------------------------------------------------------------
# The broker
# --------------------------------------------------------------------------

class Broker:
    def __init__(self) -> None:
        self.cfg = load_config()
        LOG.configure(self.cfg)
        TRANSCRIPT.configure(self.cfg)

        self.enabled = read_state(ENABLED_FILE, "1" if self.cfg.get("enabled", True) else "0") == "1"
        self.verbosity = read_state(VERBOSITY_FILE, self.cfg.get("verbosity", "normal"))
        if self.verbosity not in VERBOSITIES:
            self.verbosity = "normal"

        self.mic_ok = True
        self._mic_state = ""
        self._queue: list[tuple[int, int, Intent]] = []
        self._seq = 0
        self._cv = threading.Condition()
        self._stop_current = threading.Event()
        self._speaking: Intent | None = None
        self._shutdown = threading.Event()

        self._dedup: dict[str, float] = {}
        self._rate: dict[str, collections.deque[float]] = collections.defaultdict(collections.deque)

        self.player = Player(self.cfg)
        self.voices: dict[str, Voice] = {}
        self._voice_lock = threading.Lock()
        self._build_voices()

        self.stats = collections.Counter()

    # -- voices ------------------------------------------------------------

    def _build_voices(self) -> None:
        with self._voice_lock:
            for v in self.voices.values():
                v.stop()
            self.voices = {}
            vcfg = self.cfg["voice"]
            self.voices["system"] = Voice("system", self.cfg, vcfg["system"])
            agent = vcfg.get("agent") or {}
            if agent.get("enabled") and agent.get("model"):
                self.voices["agent"] = Voice("agent", self.cfg, agent)
            for v in self.voices.values():
                v.start()

    def _voice_for(self, category: str) -> Voice:
        want = self.cfg["voice"].get("category_map", {}).get(category, "system")
        v = self.voices.get(want)
        if v is None:
            v = self.voices["system"]
        return v

    # -- submission --------------------------------------------------------

    def spoken_name(self) -> str:
        ident = self.cfg.get("identity") or {}
        return ident.get("spoken_as") or ident.get("name") or "Prometheus"

    def resolve_name(self, text: str) -> str:
        """Substitute {{name}} so producers never need to read the config."""
        return text.replace("{{name}}", self.spoken_name()) if "{{name}}" in text else text

    def submit(self, obj: dict, conn=None) -> None:
        if "control" in obj:
            self._control(obj, conn)
            return

        text = self.resolve_name((obj.get("text") or "").strip())
        priority = obj.get("priority") or "normal"
        if priority not in PRIORITY_RANK:
            priority = "normal"
        category = obj.get("category") or "manual"
        preempt = bool(obj.get("preempt")) or priority == "critical"
        try:
            ttl_ms = int(obj.get("ttl_ms") or 0)
        except (TypeError, ValueError):
            ttl_ms = 0
        dedup_key = obj.get("dedup_key") or None

        with self._cv:
            self._seq += 1
            iid = self._seq

        LOG.debug("intent.received", text[:80], id=iid, priority=priority,
                  category=category, dedup_key=dedup_key, ttl_ms=ttl_ms or None,
                  words=len(text.split()) or None)

        def drop(reason: str, detail: str = "") -> None:
            """One exit for every rejection, so a silence always has a reason."""
            self.stats[f"dropped_{reason}"] += 1
            LOG.debug("intent.dropped", detail or reason, id=iid, priority=priority,
                      category=category, reason=reason)
            if TRANSCRIPT.log_dropped:
                TRANSCRIPT.write("out", text, id=iid, status="dropped", reason=reason,
                                 priority=priority, category=category)
            self._ack(conn, "dropped", detail or reason)

        if not text:
            drop("empty", "empty text")
            return

        now = time.monotonic()

        if not self.enabled:
            drop("disabled")
            return

        if priority == "debug" and self.verbosity != "chatty":
            drop("verbosity", f"debug intent at verbosity={self.verbosity}")
            return

        if dedup_key:
            window = float(self.cfg["limits"]["dedup_window_secs"])
            last = self._dedup.get(dedup_key)
            if last is not None and now - last < window:
                drop("dedup", "dedup")
                return

        # Critical is exempt: a blocked agent must always be able to speak.
        if priority != "critical" and not self._rate_ok(category, now):
            drop("ratelimit", "rate limit")
            return

        with self._cv:
            if priority == "ambient" and (self._queue or self._speaking is not None):
                drop("ambient", "ambient superseded")
                return

            if dedup_key:
                self._dedup[dedup_key] = now
                if len(self._dedup) > 512:
                    cutoff = now - float(self.cfg["limits"]["dedup_window_secs"])
                    self._dedup = {k: t for k, t in self._dedup.items() if t >= cutoff}

            self._record_rate(category, now)
            intent = Intent(text, priority, category, dedup_key, ttl_ms, preempt,
                            iid, conn)
            heapq.heappush(self._queue, (PRIORITY_RANK[priority], iid, intent))
            self.stats["accepted"] += 1
            depth = len(self._queue)
            preempting = preempt and self._speaking is not None
            if preempting:
                self.stats["preemptions"] += 1
                self._stop_current.set()
                self.player.kill_current()
            self._cv.notify_all()

        LOG.debug("intent.queued", "preempting current utterance" if preempting else "",
                  id=iid, priority=priority, category=category, queue_depth=depth)

    def _rate_ok(self, category: str, now: float) -> bool:
        limits = self.cfg["limits"]
        cap = int(limits.get("per_category", {}).get(
            category, limits["max_utterances_per_minute"]))
        if cap <= 0:
            return False
        dq = self._rate[category]
        while dq and now - dq[0] > 60.0:
            dq.popleft()
        return len(dq) < cap

    def _record_rate(self, category: str, now: float) -> None:
        self._rate[category].append(now)

    def _ack(self, conn, status: str, detail: str = "") -> None:
        if conn is None:
            return
        try:
            conn.sendall(json.dumps({"status": status, "detail": detail}).encode() + b"\n")
        except OSError:
            pass

    # -- control -----------------------------------------------------------

    def _control(self, obj: dict, conn) -> None:
        cmd = obj.get("control")
        if cmd in ("stop", "shutup", "flush"):
            self.flush("shut-up")
            self._ack(conn, "ok", "flushed")
        elif cmd == "reload":
            self.reload_config()
            self._ack(conn, "ok", "reloaded")
        elif cmd == "ping":
            self._ack(conn, "ok", "pong")
        else:
            self._ack(conn, "error", f"unknown control {cmd!r}")

    def flush(self, why: str) -> None:
        """Unconditional, immediate silence. Drops everything queued."""
        with self._cv:
            dropped = len(self._queue)
            for _, _, intent in self._queue:
                LOG.debug("intent.dropped", why, id=intent.seq, reason="flushed",
                          priority=intent.priority, category=intent.category)
                self._ack(intent.conn, "dropped", why)
            self._queue.clear()
            self._stop_current.set()
            cutting = self._speaking is not None
        self.player.kill_current()
        self.stats["flushes"] += 1
        LOG.info("queue.flushed", why, dropped=dropped or None,
                 cut_current=cutting or None)

    # -- state changes -----------------------------------------------------

    def set_enabled(self, on: bool) -> None:
        if on == self.enabled:
            return
        self.enabled = on
        LOG.info("gate.enabled", "on" if on else "off — intents will be accepted and dropped")
        if not on:
            self.flush("disabled")

    def set_mic_ok(self, ok: bool, state: str = "") -> None:
        if state:
            self._mic_state = state
        if ok == self.mic_ok:
            return
        self.mic_ok = ok
        LOG.info("gate.mic",
                 "open — resuming the queue" if ok
                 else "HELD — microphone is live, stopping speech now",
                 state=self._mic_state or None)
        if not ok:
            # Hard stop, immediately. Hold the queue rather than dropping it.
            with self._cv:
                self._stop_current.set()
            self.player.kill_current()
        else:
            with self._cv:
                self._cv.notify_all()

    def reload_config(self) -> None:
        old = self.cfg
        self.cfg = load_config()
        LOG.configure(self.cfg)
        TRANSCRIPT.configure(self.cfg)
        self.player.latency_msec = int(self.cfg["audio"]["latency_msec"])
        if old["voice"] != self.cfg["voice"]:
            LOG.info("config.voice_changed", "respawning piper")
            self._build_voices()
        LOG.info("config.reloaded", path=CONFIG_FILE, log_level=self.cfg.get("log_level"))

    # -- the speaker -------------------------------------------------------

    def _next_intent(self) -> Intent | None:
        """Block until something is speakable. No polling."""
        with self._cv:
            while not self._shutdown.is_set():
                now = time.monotonic()

                # Expire stale intents.
                if self._queue:
                    live = [e for e in self._queue if not e[2].expired(now)]
                    if len(live) != len(self._queue):
                        for e in self._queue:
                            if e[2].expired(now):
                                self.stats["dropped_ttl"] += 1
                                it = e[2]
                                LOG.debug("intent.dropped",
                                          f"still queued {(now - it.enqueued) * 1000:.0f}ms "
                                          f"after a {it.ttl_ms}ms ttl",
                                          id=it.seq, reason="ttl", priority=it.priority,
                                          category=it.category)
                                if TRANSCRIPT.log_dropped:
                                    TRANSCRIPT.write("out", it.text, id=it.seq,
                                                     status="dropped", reason="ttl",
                                                     priority=it.priority,
                                                     category=it.category)
                                self._ack(it.conn, "dropped", "ttl expired")
                        self._queue = live
                        heapq.heapify(self._queue)

                if self._queue and self.enabled and self.mic_ok:
                    _, _, intent = heapq.heappop(self._queue)
                    self._speaking = intent
                    self._stop_current.clear()
                    return intent

                # Wake at the next TTL deadline, or sleep indefinitely.
                timeout = None
                deadlines = [e[2].deadline for e in self._queue if e[2].deadline]
                if deadlines:
                    timeout = max(0.0, min(deadlines) - now)
                self._cv.wait(timeout=timeout)
        return None

    def speaker_loop(self) -> None:
        while not self._shutdown.is_set():
            intent = self._next_intent()
            if intent is None:
                break
            try:
                self._speak(intent)
            except PiperDied:
                self.stats["piper_deaths"] += 1
                self._ack(intent.conn, "dropped", "synthesis failed")
                LOG.warn("intent.failed", "piper died mid-synthesis", id=intent.seq,
                         category=intent.category)
            except Exception as e:  # never let the speaker thread die
                LOG.error("intent.error", repr(e), id=intent.seq)
                self._ack(intent.conn, "dropped", "internal error")
            finally:
                with self._cv:
                    self._speaking = None
                    self._cv.notify_all()

    def _speak(self, intent: Intent) -> None:
        voice = self._voice_for(intent.category)
        if not voice.start():
            raise PiperDied(voice.name)

        rate = voice.sample_rate
        gap_ms = int(self.cfg["audio"]["inter_sentence_ms"])
        gap = b"\x00" * (round(rate * gap_ms / 1000.0) * BYTES_PER_SAMPLE)
        sentences = split_sentences(intent.text)

        t0 = time.monotonic()
        queued_ms = (t0 - intent.enqueued) * 1000
        first_sound = None
        synth_ms = 0.0
        audio_bytes = 0
        finished = True
        for i, sentence in enumerate(sentences):
            if self._stop_current.is_set():
                finished = False
                break
            ts = time.monotonic()
            pcm = voice.synth(sentence)
            synth_ms += (time.monotonic() - ts) * 1000
            if i and gap:
                pcm = gap + pcm
            audio_bytes += len(pcm)
            if first_sound is None:
                first_sound = time.monotonic() - t0
            if not self.player.play(pcm, self._stop_current, rate):
                finished = False
                break

        ttfs_ms = (first_sound or 0) * 1000
        audio_ms = audio_bytes / (rate * BYTES_PER_SAMPLE) * 1000
        common = dict(id=intent.seq, priority=intent.priority,
                      category=intent.category, voice=voice.name)

        if finished:
            self.stats["spoken"] += 1
            if intent.dedup_key:
                self._dedup[intent.dedup_key] = time.monotonic()
            LOG.info("intent.spoken", intent.text, **common,
                     ttfs_ms=round(ttfs_ms), synth_ms=round(synth_ms),
                     audio_ms=round(audio_ms), queued_ms=round(queued_ms),
                     sentences=len(sentences) if len(sentences) > 1 else None)
            TRANSCRIPT.write("out", intent.text, status="spoken", **common,
                             ttfs_ms=round(ttfs_ms), audio_ms=round(audio_ms))
            self._ack(intent.conn, "spoken", f"{ttfs_ms:.0f}ms")
        else:
            self.stats["interrupted"] += 1
            spoken_ms = (time.monotonic() - t0) * 1000
            LOG.info("intent.interrupted",
                     f"cut after {spoken_ms:.0f}ms of a {audio_ms:.0f}ms utterance",
                     **common)
            TRANSCRIPT.write("out", intent.text, status="interrupted", **common,
                             spoken_ms=round(spoken_ms), audio_ms=round(audio_ms))
            self._ack(intent.conn, "interrupted", f"{spoken_ms:.0f}ms")

    def shutdown(self) -> None:
        self._shutdown.set()
        self.flush("shutdown")
        with self._cv:
            self._cv.notify_all()
        with self._voice_lock:
            for v in self.voices.values():
                v.stop()


# --------------------------------------------------------------------------
# Watchers
# --------------------------------------------------------------------------

def watcher_thread(broker: Broker) -> None:
    ino = Inotify()
    mask_cfg = IN_CLOSE_WRITE | IN_MOVED_TO | IN_CREATE
    mask_state = IN_CLOSE_WRITE | IN_MOVED_TO | IN_CREATE | IN_MODIFY

    os.makedirs(CONFIG_DIR, exist_ok=True)
    os.makedirs(STATE_DIR, exist_ok=True)
    ino.add(CONFIG_DIR, mask_cfg)
    ino.add(STATE_DIR, mask_state)
    LOG.debug("watch.installed", "inotify watches active — no polling",
              config=CONFIG_DIR, state=STATE_DIR)

    if broker.cfg["mic_gate"]["enabled"]:
        if os.path.isdir(VOXTYPE_DIR):
            ino.add(VOXTYPE_DIR, mask_state)
            LOG.info("gate.mic_watching", "speech will stop when the mic goes live",
                     path=VOXTYPE_STATE,
                     speak_states=",".join(broker.cfg["mic_gate"]["speak_states"]))
            apply_mic_state(broker)
        else:
            LOG.warn("gate.mic_unavailable",
                     "voxtype dir absent; speech will NOT stop for the microphone",
                     path=VOXTYPE_DIR)

    while not broker._shutdown.is_set():
        try:
            events = list(ino.read_events())
        except OSError as e:
            if e.errno == errno.EINTR:
                continue
            break
        for path, name, _mask in events:
            if path == CONFIG_DIR and name in ("config.json", "persona.md", "about-me.md"):
                broker.reload_config()
            elif path == STATE_DIR and name == "enabled":
                broker.set_enabled(read_state(ENABLED_FILE, "1") == "1")
            elif path == STATE_DIR and name == "verbosity":
                v = read_state(VERBOSITY_FILE, "normal")
                if v in VERBOSITIES:
                    broker.verbosity = v
                    LOG.info("gate.verbosity", v)
            elif path == VOXTYPE_DIR and name == "state":
                apply_mic_state(broker)
    ino.close()


def apply_mic_state(broker: Broker) -> None:
    state = read_state(VOXTYPE_STATE, "idle")
    if not state:
        return
    broker.set_mic_ok(state in broker.cfg["mic_gate"]["speak_states"], state)


# --------------------------------------------------------------------------
# Socket server
# --------------------------------------------------------------------------

def server_thread(broker: Broker, server: socket.socket) -> None:
    sel = selectors.DefaultSelector()
    sel.register(server, selectors.EVENT_READ, None)
    buffers: dict[socket.socket, bytearray] = {}

    while not broker._shutdown.is_set():
        try:
            ready = sel.select(timeout=None)
        except OSError:
            break
        for key, _ in ready:
            if key.data is None:
                try:
                    conn, _ = server.accept()
                except OSError:
                    continue
                conn.setblocking(False)
                buffers[conn] = bytearray()
                sel.register(conn, selectors.EVENT_READ, True)
                continue

            conn = key.fileobj
            try:
                data = conn.recv(65536)
            except (BlockingIOError, InterruptedError):
                continue
            except OSError:
                data = b""

            if not data:
                sel.unregister(conn)
                buffers.pop(conn, None)
                conn.close()
                continue

            buf = buffers[conn]
            buf.extend(data)
            while b"\n" in buf:
                line, _, rest = buf.partition(b"\n")
                buf.clear()
                buf.extend(rest)
                line = line.strip()
                if not line:
                    continue
                try:
                    obj = json.loads(line)
                except ValueError:
                    LOG.warn("socket.bad_json", repr(line[:160]))
                    continue
                if not isinstance(obj, dict):
                    continue
                # A producer opts into a reply with "ack": true. Everything
                # else stays fire-and-forget, exactly as docs/01 specifies.
                broker.submit(obj, conn if obj.get("ack") else None)
    sel.close()


# --------------------------------------------------------------------------
# systemd readiness
# --------------------------------------------------------------------------

def sd_notify(message: str) -> None:
    addr = os.environ.get("NOTIFY_SOCKET")
    if not addr:
        return
    if addr.startswith("@"):
        addr = "\0" + addr[1:]
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as s:
            s.connect(addr)
            s.sendall(message.encode())
    except OSError:
        pass


# --------------------------------------------------------------------------
# main
# --------------------------------------------------------------------------

def main() -> int:
    os.makedirs(SOCK_DIR, mode=0o700, exist_ok=True)
    os.makedirs(STATE_DIR, exist_ok=True)

    broker = Broker()

    # Bind before announcing readiness so `systemctl start` returning means the
    # socket exists — producers never race against startup.
    if os.path.exists(SOCK_PATH):
        os.unlink(SOCK_PATH)
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(SOCK_PATH)
    os.chmod(SOCK_PATH, 0o600)
    server.listen(64)
    server.setblocking(False)

    def on_term(_signum, _frame):
        LOG.info("daemon.stopping", f"signal {_signum}")
        broker.shutdown()

    signal.signal(signal.SIGTERM, on_term)
    signal.signal(signal.SIGINT, on_term)
    signal.signal(signal.SIGUSR1,
                  lambda *_: LOG.info("daemon.stats", **dict(broker.stats)))

    threading.Thread(target=server_thread, args=(broker, server), daemon=True,
                     name="socket").start()
    threading.Thread(target=watcher_thread, args=(broker,), daemon=True,
                     name="inotify").start()

    sd_notify("READY=1")
    LOG.info("daemon.ready", "accepting speech intents", socket=SOCK_PATH,
             name=broker.spoken_name(),
             enabled=broker.enabled, verbosity=broker.verbosity,
             voices=",".join(broker.voices), pid=os.getpid(),
             log_file=LOG.file_path, transcript=TRANSCRIPT.path)

    try:
        broker.speaker_loop()
    finally:
        broker.shutdown()
        try:
            server.close()
            os.unlink(SOCK_PATH)
        except OSError:
            pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
