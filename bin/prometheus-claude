#!/usr/bin/env python3
"""prometheus-claude — Claude Code hook narrator (Phase 3).

Registered in ~/.claude/settings.json as the `command` for both the `Stop`
and `Notification` hooks. One binary handles both: the JSON on stdin carries
its own `hook_event_name`, so there is no need for separate entry points or
argv dispatch.

Schema verified empirically before any of this was written — never assumed.
See experiments/hook-schema-findings.md for the method (a live capture plus
strings extracted from the installed `claude` binary's own schema) and for
where an initial LLM-guessed answer about the payload shape turned out to be
wrong. In short:

  Stop:         {session_id, transcript_path, cwd, permission_mode,
                 hook_event_name, stop_hook_active, last_assistant_message,
                 background_tasks, session_crons, prompt_id}
  Notification: {session_id, transcript_path, cwd, permission_mode,
                 hook_event_name, message, title?, notification_type}

Never blocks or slows a Claude turn (docs/01, docs/05 R9):
  - registered with "async": true in settings.json (a real field, confirmed
    against the binary's own hook schema — belt-and-suspenders on top of
    the daemon-side fire-and-forget socket contract everything else here
    already relies on).
  - every code path below degrades to silence, never an exception: parsing
    and dispatch run inside a top-level try/except in main() that always
    exits 0, and every subprocess call (say/phrase/summarize) carries its
    own timeout so a stuck child process can't hang this one.
  - `prometheus say` itself never blocks: it fails silently against a dead
    socket (bin/prometheus's own contract).

Every invocation is logged to ~/.local/state/prometheus/prometheus-claude.log
— event, outcome, reason, and a preview of the input and what (if anything)
was spoken — whether or not this run actually found something to say.
"""
from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import threading
import time

HOME = os.path.expanduser("~")
CONFIG_DIR = os.environ.get("PROMETHEUS_CONFIG_DIR") or os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or f"{HOME}/.config", "prometheus"
)
STATE_DIR = os.environ.get("PROMETHEUS_STATE_DIR") or os.path.join(
    os.environ.get("XDG_STATE_HOME") or f"{HOME}/.local/state", "prometheus"
)
CONFIG_FILE = os.path.join(CONFIG_DIR, "config.json")
CLAUDE_HOME = os.path.join(HOME, ".claude")
SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
PROMETHEUS_BIN = os.path.join(SCRIPT_DIR, "prometheus")
PHRASEBANK_BIN = os.path.join(SCRIPT_DIR, "prometheus-phrasebank")
LLM_BIN = os.path.join(SCRIPT_DIR, "prometheus-llm")

DEFAULT_CONFIG = {
    "log_level": "info",
    "logging": {"file_enabled": True, "file_level": "debug", "max_bytes": 4194304},
    "limits": {"max_words_summary": 30},
    "speak": {
        "claude_blocked":  {"enabled": True, "priority": "critical"},
        "claude_finished": {"enabled": True, "priority": "normal", "min_turn_secs": 0,
                             "short_circuit_words": 25},
    },
}


# --------------------------------------------------------------------------
# config + logging (same shape as prometheusd, prometheus-hypr, prometheus-llm)
# --------------------------------------------------------------------------

def deep_merge(base: dict, over: dict) -> dict:
    out = dict(base)
    for k, v in (over or {}).items():
        if isinstance(v, dict) and isinstance(out.get(k), dict):
            out[k] = deep_merge(out[k], v)
        else:
            out[k] = v
    return out


def strip_jsonc(text: str) -> str:
    out, in_str, esc, i = [], False, False, 0
    while i < len(text):
        c = text[i]
        if in_str:
            out.append(c)
            if esc:
                esc = False
            elif c == "\\":
                esc = True
            elif c == '"':
                in_str = False
        elif c == '"':
            in_str = True
            out.append(c)
        elif c == "/" and i + 1 < len(text) and text[i + 1] == "/":
            while i < len(text) and text[i] != "\n":
                i += 1
            continue
        else:
            out.append(c)
        i += 1
    return "".join(out)


def load_config() -> dict:
    try:
        with open(CONFIG_FILE) as f:
            raw = json.loads(strip_jsonc(f.read()))
    except FileNotFoundError:
        return dict(DEFAULT_CONFIG)
    except (OSError, ValueError):
        return dict(DEFAULT_CONFIG)
    return deep_merge(DEFAULT_CONFIG, raw)


LEVELS = {"debug": 0, "info": 1, "warn": 2, "error": 3}


class Log:
    def __init__(self) -> None:
        self.level = LEVELS["info"]
        self.file_level = LEVELS["debug"]
        self.file_path: str | None = os.path.join(STATE_DIR, "prometheus-claude.log")
        self.max_bytes = 4 * 1024 * 1024
        self._lock = threading.Lock()

    def configure(self, cfg: dict) -> None:
        lg = cfg.get("logging", {})
        self.level = LEVELS.get(cfg.get("log_level", "info"), LEVELS["info"])
        self.file_level = LEVELS.get(lg.get("file_level", "debug"), LEVELS["debug"])
        self.max_bytes = int(lg.get("max_bytes", 4 * 1024 * 1024))
        self.file_path = (
            os.path.join(STATE_DIR, "prometheus-claude.log") if lg.get("file_enabled", True) else None
        )

    def emit(self, level: str, event: str, msg: str = "", **fields) -> None:
        lv = LEVELS[level]
        now = time.time()
        if lv >= self.level and sys.stderr.isatty():
            parts = " ".join(f"{k}={v}" for k, v in fields.items() if v is not None)
            line = f"{time.strftime('%H:%M:%S', time.localtime(now))} {level.upper():<5} {event}"
            if msg:
                line += f": {msg}"
            if parts:
                line += "  " + parts
            print(line, file=sys.stderr)
        if lv >= self.file_level and self.file_path:
            rec = {"t": round(now, 3), "level": level, "event": event}
            if msg:
                rec["msg"] = msg
            rec.update({k: v for k, v in fields.items() if v is not None})
            with self._lock:
                try:
                    os.makedirs(os.path.dirname(self.file_path), exist_ok=True)
                    with open(self.file_path, "a") as f:
                        f.write(json.dumps(rec, default=str) + "\n")
                        if f.tell() >= self.max_bytes:
                            os.replace(self.file_path, self.file_path + ".1")
                except OSError:
                    pass

    def debug(self, event, msg="", **f): self.emit("debug", event, msg, **f)
    def info(self, event, msg="", **f): self.emit("info", event, msg, **f)
    def warn(self, event, msg="", **f): self.emit("warn", event, msg, **f)
    def error(self, event, msg="", **f): self.emit("error", event, msg, **f)


LOG = Log()


def preview(text: str, n: int = 150) -> str:
    text = " ".join(text.split())
    return text if len(text) <= n else text[:n] + "…"


# --------------------------------------------------------------------------
# strip markdown / code / paths before speech (docs/01: "unspeakable")
#
# Same intent as bin/prometheus-llm's post_filter, kept as its own copy here
# rather than a shared import — every producer in bin/ already carries its
# own copy of this kind of boilerplate (Log, deep_merge, strip_jsonc), and a
# hook script that never imports a sibling module is one less thing that can
# break the "never blocks a Claude turn" contract.
# --------------------------------------------------------------------------

CODE_FENCE_RE = re.compile(r"```.*?```", re.DOTALL)
BACKTICK_RE = re.compile(r"`([^`]*)`")
LIST_MARKER_RE = re.compile(r"(?m)^\s*(?:[-*•]|\d+[.)])\s+")
HEADING_RE = re.compile(r"(?m)^#{1,6}\s+")
BOLD_ITALIC_RE = re.compile(r"(\*\*\*|\*\*|\*|__|_)(\S.*?\S|\S)\1")
PATH_TOKEN_RE = re.compile(
    # Unlike prometheus-llm's post_filter (a backstop over already-LLM-
    # rewritten text), this is the ONLY sanitizer on the short-circuit path,
    # so it has to catch bare relative paths too — "src/auth/middleware.ts"
    # has no leading "/", and a prefix-anchored-on-"/" pattern leaves "src"
    # dangling (caught in testing; see notes/2026-09-11-phase-3.md).
    r"[~\w.\-]*/[\w.\-]+(?:/[\w.\-]+)*"
    r"|\b[\w\-]+\.(?:py|js|ts|jsx|tsx|json|md|c|h|cpp|sh|rs|go|toml|yaml|yml|cfg|ini|log)\b"
)


def strip_for_speech(raw: str) -> str:
    text = CODE_FENCE_RE.sub(" ", raw)
    text = BACKTICK_RE.sub(r"\1", text)
    text = HEADING_RE.sub("", text)
    text = LIST_MARKER_RE.sub("", text)
    text = BOLD_ITALIC_RE.sub(r"\2", text)
    text = PATH_TOKEN_RE.sub("", text)
    text = re.sub(r"\s+", " ", text).strip()
    return text


# --------------------------------------------------------------------------
# speaking — shell out to the existing CLI rather than touch the socket
# directly, so dedup/rate-limit/mic-gate/voice-mapping all stay owned by
# prometheusd and bin/prometheus, not duplicated here.
# --------------------------------------------------------------------------

def say(text: str, priority: str, dedup_key: str | None = None, ttl_ms: int | None = None) -> None:
    if not text:
        return
    args = [PROMETHEUS_BIN, "say", text, "-p", priority, "-c", "claude"]
    if dedup_key:
        args += ["--dedup-key", dedup_key]
    if ttl_ms:
        args += ["--ttl", str(ttl_ms)]
    try:
        subprocess.run(args, timeout=5, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired) as e:
        LOG.warn("say.failed", str(e))


def phrase(event: str, slots: dict | None = None) -> str | None:
    args = [PHRASEBANK_BIN, "pick", event]
    for k, v in (slots or {}).items():
        args += ["--slot", f"{k}={v}"]
    try:
        out = subprocess.run(args, capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired) as e:
        LOG.warn("phrase.failed", str(e), bank_event=event)
        return None
    if out.returncode != 0:
        LOG.warn("phrase.miss", "no phrasebank entry or bank missing", bank_event=event)
        return None
    line = out.stdout.strip()
    return line or None


def summarize(text: str) -> str | None:
    try:
        out = subprocess.run([LLM_BIN, "summarize", "-c", "claude"],
                              input=text, capture_output=True, text=True, timeout=8)
    except (OSError, subprocess.TimeoutExpired) as e:
        LOG.warn("summarize.failed", str(e))
        return None
    line = out.stdout.strip()
    return line or None


# --------------------------------------------------------------------------
# multi-session disambiguation (task 3.7) — which project is talking?
# --------------------------------------------------------------------------

def active_claude_cwds() -> set[str]:
    """Best-effort scan of /proc for other `claude` processes' cwds.

    Degrades to an empty set on anything unexpected (non-Linux, permission
    denied, /proc racing a process exit) — the caller then just treats the
    session as the only one, which is the safe default (a plain "Claude
    needs you" is never wrong, just occasionally less specific than it
    could be).
    """
    cwds: set[str] = set()
    try:
        for pid in os.listdir("/proc"):
            if not pid.isdigit():
                continue
            try:
                with open(f"/proc/{pid}/comm") as f:
                    comm = f.read().strip()
            except OSError:
                continue
            if comm != "claude":
                continue
            try:
                cwd = os.readlink(f"/proc/{pid}/cwd")
            except OSError:
                continue
            # Claude Code spawns internal helpers (e.g. the Claude-in-Chrome
            # bridge) that also run the `claude` binary but aren't a coding
            # session with a project to name — found empirically, running
            # this scan against a live desktop turned one up at
            # ~/.claude/chrome. Exclude anything under ~/.claude itself.
            if cwd == CLAUDE_HOME or cwd.startswith(CLAUDE_HOME + os.sep):
                continue
            cwds.add(cwd)
    except OSError:
        pass
    return cwds


def project_name(cwd: str) -> str:
    base = os.path.basename(os.path.normpath(cwd)) or cwd
    return base.replace("-", " ").replace("_", " ").title()


# --------------------------------------------------------------------------
# hook handlers
# --------------------------------------------------------------------------

def handle_stop(payload: dict, cfg: dict) -> None:
    sc = cfg["speak"]["claude_finished"]
    if not sc.get("enabled", True):
        LOG.debug("stop.disabled")
        return

    raw = (payload.get("last_assistant_message") or "").strip()
    if not raw:
        LOG.info("stop.empty", "no last_assistant_message — speaking the bare fact of it")
        line = phrase("claude_finished")
        if line:
            say(line, sc.get("priority", "normal"))
        else:
            LOG.warn("stop.no_phrase", "claude_finished missing from bank; staying silent")
        return

    cleaned = strip_for_speech(raw)
    if not cleaned:
        LOG.info("stop.stripped_to_nothing", input=preview(raw))
        line = phrase("claude_finished")
        if line:
            say(line, sc.get("priority", "normal"))
        return

    threshold = int(sc.get("short_circuit_words", 25))
    word_count = len(cleaned.split())

    if word_count < threshold:
        LOG.info("stop.short_circuit", input=preview(raw), output=cleaned,
                  word_count=word_count, threshold=threshold)
        say(cleaned, sc.get("priority", "normal"))
        return

    LOG.debug("stop.summarizing", input=preview(raw), word_count=word_count, threshold=threshold)
    summary = summarize(raw)
    if not summary:
        LOG.info("stop.silent", "summarizer produced nothing — degrading to silence",
                  input=preview(raw))
        return
    LOG.info("stop.summarized", input=preview(raw), output=summary)
    say(summary, sc.get("priority", "normal"))


def handle_notification(payload: dict, cfg: dict) -> None:
    sb = cfg["speak"]["claude_blocked"]
    if not sb.get("enabled", True):
        LOG.debug("notification.disabled")
        return

    session_id = payload.get("session_id") or "unknown"
    notification_type = payload.get("notification_type")
    cwd = payload.get("cwd") or ""

    cwds = active_claude_cwds()
    if cwd:
        cwds.add(cwd)
    multi = len({c for c in cwds if c}) > 1

    if multi and cwd:
        proj = project_name(cwd)
        line = phrase("claude_blocked_project", {"project": proj})
        bank_event = "claude_blocked_project"
    else:
        proj = None
        line = phrase("claude_blocked")
        bank_event = "claude_blocked"

    if not line:
        # Fail toward saying SOMETHING for the highest-value event in the
        # project (docs/01) rather than silence, but only as a last resort —
        # the phrase bank missing entirely means `prometheus regenerate`
        # hasn't been run yet.
        line = f"Claude needs you — {proj}." if proj else "Claude needs you."
        LOG.warn("notification.no_bank", "phrase bank miss, using a literal fallback",
                  bank_event=bank_event)

    LOG.info("notification.spoken", output=line, bank_event=bank_event, project=proj,
              notification_type=notification_type, session_id=session_id,
              active_sessions=len({c for c in cwds if c}) or 1)
    say(line, sb.get("priority", "critical"), dedup_key=f"claude_blocked:{session_id}",
        ttl_ms=15000)


# --------------------------------------------------------------------------
# entry point
# --------------------------------------------------------------------------

def main() -> int:
    cfg = load_config()
    LOG.configure(cfg)

    try:
        raw_stdin = sys.stdin.read()
    except Exception as e:
        LOG.error("stdin.unreadable", str(e))
        return 0

    try:
        payload = json.loads(raw_stdin) if raw_stdin.strip() else {}
    except ValueError as e:
        LOG.error("payload.invalid_json", str(e), raw=preview(raw_stdin))
        return 0

    hook_event = payload.get("hook_event_name")
    try:
        if hook_event == "Stop":
            handle_stop(payload, cfg)
        elif hook_event == "Notification":
            handle_notification(payload, cfg)
        else:
            LOG.debug("event.unhandled", hook_event=hook_event)
    except Exception as e:
        # Fail-silent applies to crashes too (docs/05 R9): a hook must never
        # break or visibly slow the turn it fired on, no matter what.
        LOG.error("handler.crash", str(e), hook_event=hook_event)

    return 0


if __name__ == "__main__":
    sys.exit(main())
