#!/usr/bin/env python3
"""prometheus-hypr — Hyprland event listener, journal and ambient narrator.

Reads Hyprland's push-based event feed (`.socket2.sock`), filters it down to
what's worth remembering, appends the result to
~/.local/state/prometheus/journal as JSONL, and — since Phase 5 — decides which
of those events is worth *saying*.

Phase 1 deliberately built no narration: "collecting data first". Phase 5 spent
that data. The scoring it now runs lives in `bin/prometheus-attention`, shared
verbatim with `experiments/replay-scoring.py`, so what the replay harness
predicts and what this process does are the same arithmetic rather than two
implementations that agree until they don't.

Filtering (docs/01-architecture.md):
  - windowtitle / windowtitlev2 are dropped unconditionally, unread. Titles
    change on every spinner frame — the concrete bug found in
    docs/00-feasibility.md.
  - Focus changes are debounced (~1.5s of quiet) so alt-tabbing through six
    windows produces one journal entry, not six.
  - **Workspace switches are debounced the same way, as of Phase 5.** They were
    not, and docs/01 had them as the always-spoken `quiet` floor. Replayed
    against real history that meant 90 utterances in 7.5 hours with a median
    gap of 1.4 seconds between them — one burst was nine switches in nine
    seconds. Those are not nine destinations, they are one journey. Same rule
    as focus now: stay quiet while moving, mention where you stopped.
  - Allowlist, not denylist: only app classes with a friendly name in
    config.json's hypr.app_names are journaled by open/close/focus. An
    unmapped class is logged once at debug level (to find and add later),
    never written to the journal.

Empirical note, not in the Hyprland docs: a window whose *title* is animating
(this very Claude Code session, mid-turn) also re-fires activewindow(v2) on
every title change, not just windowtitle(v2) — confirmed live against this
machine's socket while writing this. So the debounce keys off whether the
focused *address* actually changed, not just off event arrival: a repeat
announcement of the address already pending or already settled resets
nothing. Without that, a long-spinning title would hold focus settlement open
indefinitely.

Stdlib only, single-threaded event loop: selectors over the Hyprland socket
and an inotify fd for config hot-reload, timeout computed from the next
pending debounce deadline. No polling (docs/07-resource-profile.md).
"""

from __future__ import annotations

import ctypes
import errno
import importlib.machinery
import importlib.util
import json
import os
import random
import selectors
import signal
import socket
import struct
import subprocess
import sys
import time

# realpath, not abspath: install.sh symlinks this into ~/.local/bin, and
# abspath would resolve the sibling lookup below against that directory — where
# prometheus-attention deliberately isn't, since it's a library with nothing to
# run. Invoked through the symlink, narration would have silently degraded to
# journal-only. Matches prometheus-claude's SCRIPT_DIR, which already does this.
BIN_DIR = os.path.dirname(os.path.realpath(__file__))


def _load_sibling(name: str, mod_name: str):
    """Import an extension-less sibling executable as a module.

    Same mechanism experiments/test-phrasebank.py uses. Kept tolerant: a
    missing or broken sibling must degrade this process to journal-only, never
    stop it collecting. Losing narration for a session is an inconvenience;
    losing the journal loses the evidence that makes tuning possible at all.
    """
    path = os.path.join(BIN_DIR, name)
    try:
        loader = importlib.machinery.SourceFileLoader(mod_name, path)
        spec = importlib.util.spec_from_loader(mod_name, loader)
        mod = importlib.util.module_from_spec(spec)
        loader.exec_module(mod)
        return mod
    except (OSError, ImportError, SyntaxError, ValueError):
        return None


ATTN = _load_sibling("prometheus-attention", "prometheus_attention")
PB = _load_sibling("prometheus-phrasebank", "prometheus_phrasebank")

HOME = os.path.expanduser("~")
RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
CONFIG_DIR = os.environ.get("PROMETHEUS_CONFIG_DIR") or os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or f"{HOME}/.config", "prometheus"
)
STATE_DIR = os.environ.get("PROMETHEUS_STATE_DIR") or os.path.join(
    os.environ.get("XDG_STATE_HOME") or f"{HOME}/.local/state", "prometheus"
)
CONFIG_FILE = os.path.join(CONFIG_DIR, "config.json")
JOURNAL_PATH = os.path.join(STATE_DIR, "journal")
SOCK_PATH = os.path.join(RUNTIME_DIR, "prometheus", "sock")
GAIN_FILE = os.path.join(STATE_DIR, "attention-gain.json")

HYPR_SIG = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
HYPR_SOCK = (
    os.path.join(RUNTIME_DIR, "hypr", HYPR_SIG, ".socket2.sock") if HYPR_SIG else None
)

DEFAULT_CONFIG = {
    "log_level": "info",
    "logging": {"file_enabled": True, "file_level": "debug", "max_bytes": 4194304},
    "hypr": {
        # Quiet time after a focus change before it's written to the journal.
        # Alt-tabbing to find a window should produce silence, then one entry
        # for where you landed — not one entry per window passed through.
        "debounce_secs": 1.5,
        # Same, for workspace switches. Phase 5 measured a 1.4s median gap
        # between them, so without this the busiest event class is also the
        # least debounced. Separate from debounce_secs because flicking
        # through workspaces is faster than alt-tabbing through windows.
        "workspace_settle_secs": 2.0,
        "journal": {"enabled": True, "max_bytes": 4194304},
        # class -> friendly name. This IS the allowlist (docs/01: "allowlist,
        # not denylist") — a class with no entry here is never journaled.
        # Seeded from this machine's installed .desktop files
        # (StartupWMClass) plus what showed up live while building this.
        # Add more as `prometheus log -f` shows unknown classes worth naming.
        "app_names": {
            "brave-browser": "Brave",
            "foot": "the terminal",
            "org.omarchy.agent": "Claude Code",
            "discord": "Discord",
            "md.obsidian.Obsidian": "Obsidian",
            "obs": "OBS",
            "kdenlive": "Kdenlive",
            "gimp": "GIMP",
            "Audacity": "Audacity",
            "keepassxc": "KeePassXC",
        },
    },
}


def deep_merge(base: dict, over: dict) -> dict:
    out = dict(base)
    for k, v in (over or {}).items():
        if isinstance(v, dict) and isinstance(out.get(k), dict):
            out[k] = deep_merge(out[k], v)
        else:
            out[k] = v
    return out


def strip_jsonc(text: str) -> str:
    """Remove // line comments outside string literals (config.json is JSONC)."""
    out, in_str, esc, i = [], False, False, 0
    while i < len(text):
        c = text[i]
        if in_str:
            out.append(c)
            if esc:
                esc = False
            elif c == "\\":
                esc = True
            elif c == '"':
                in_str = False
        elif c == '"':
            in_str = True
            out.append(c)
        elif c == "/" and i + 1 < len(text) and text[i + 1] == "/":
            while i < len(text) and text[i] != "\n":
                i += 1
            continue
        else:
            out.append(c)
        i += 1
    return "".join(out)


def load_config() -> dict:
    try:
        with open(CONFIG_FILE, "r") as f:
            raw = json.loads(strip_jsonc(f.read()))
    except FileNotFoundError:
        return dict(DEFAULT_CONFIG)
    except (OSError, ValueError):
        return dict(DEFAULT_CONFIG)
    return deep_merge(DEFAULT_CONFIG, raw)


# --------------------------------------------------------------------------
# Logging — same shape as prometheusd, so `prometheus log` reads both.
# --------------------------------------------------------------------------

LEVELS = {"debug": 10, "info": 20, "warn": 30, "error": 40}


class Log:
    def __init__(self) -> None:
        self.level = LEVELS["info"]
        self.file_level = LEVELS["debug"]
        self.file_path: str | None = None
        self.max_bytes = 4 * 1024 * 1024
        self._fh = None

    def configure(self, cfg: dict) -> None:
        lg = cfg.get("logging", {})
        self.level = LEVELS.get(cfg.get("log_level", "info"), LEVELS["info"])
        self.file_level = LEVELS.get(lg.get("file_level", "debug"), LEVELS["debug"])
        self.max_bytes = int(lg.get("max_bytes", 4 * 1024 * 1024))
        want = os.path.join(STATE_DIR, "prometheus-hypr.log") if lg.get("file_enabled", True) else None
        if want != self.file_path:
            if self._fh:
                self._fh.close()
                self._fh = None
            self.file_path = want
            self._open()

    def _open(self) -> None:
        if not self.file_path:
            return
        try:
            os.makedirs(os.path.dirname(self.file_path), exist_ok=True)
            self._fh = open(self.file_path, "a", buffering=1)
        except OSError:
            self._fh = None

    def _rotate(self) -> None:
        if not (self._fh and self.file_path):
            return
        try:
            if self._fh.tell() < self.max_bytes:
                return
            self._fh.close()
            os.replace(self.file_path, self.file_path + ".1")
            self._open()
        except OSError:
            self._fh = None

    def emit(self, level: str, event: str, msg: str = "", **fields) -> None:
        lv = LEVELS[level]
        if lv < self.level and lv < self.file_level:
            return
        now = time.time()
        if lv >= self.level:
            parts = [f"{k}={v}" for k, v in fields.items() if v is not None]
            line = f"{time.strftime('%H:%M:%S', time.localtime(now))} {level.upper():<5} {event}"
            if msg:
                line += f": {msg}"
            if parts:
                line += "  " + " ".join(parts)
            print(line, file=sys.stderr, flush=True)
        if lv >= self.file_level and self._fh:
            rec = {"t": round(now, 3), "level": level, "event": event}
            if msg:
                rec["msg"] = msg
            rec.update({k: v for k, v in fields.items() if v is not None})
            try:
                self._fh.write(json.dumps(rec, default=str) + "\n")
                self._rotate()
            except OSError:
                pass

    def debug(self, event, msg="", **f): self.emit("debug", event, msg, **f)
    def info(self, event, msg="", **f): self.emit("info", event, msg, **f)
    def warn(self, event, msg="", **f): self.emit("warn", event, msg, **f)
    def error(self, event, msg="", **f): self.emit("error", event, msg, **f)


LOG = Log()


# --------------------------------------------------------------------------
# Journal
# --------------------------------------------------------------------------

class Journal:
    """~/.local/state/prometheus/journal — append-only JSONL, rotated.

    One line per filtered event. This is the record Phase 1's replay harness
    (experiments/replay-scoring.py) and later `prometheus brief` read — never
    written to directly by anything else.
    """

    def __init__(self) -> None:
        self.path: str | None = None
        self.max_bytes = 4 * 1024 * 1024
        self._fh = None

    def configure(self, cfg: dict) -> None:
        jc = cfg.get("hypr", {}).get("journal", {})
        want = JOURNAL_PATH if jc.get("enabled", True) else None
        self.max_bytes = int(jc.get("max_bytes", 4 * 1024 * 1024))
        if want != self.path:
            if self._fh:
                self._fh.close()
                self._fh = None
            self.path = want
            self._open()

    def _open(self) -> None:
        if not self.path:
            return
        try:
            os.makedirs(os.path.dirname(self.path), exist_ok=True)
            self._fh = open(self.path, "a", buffering=1)
        except OSError:
            self._fh = None

    def write(self, kind: str, **fields) -> None:
        if not self._fh:
            return
        rec = {"t": round(time.time(), 3), "kind": kind}
        rec.update({k: v for k, v in fields.items() if v is not None})
        try:
            self._fh.write(json.dumps(rec, default=str) + "\n")
            if self._fh.tell() >= self.max_bytes:
                self._fh.close()
                os.replace(self.path, self.path + ".1")
                self._open()
        except OSError:
            pass


# --------------------------------------------------------------------------
# inotify (ctypes — mirrors prometheusd; avoids a resident inotifywait per watch)
# --------------------------------------------------------------------------

IN_CLOSE_WRITE = 0x00000008
IN_MOVED_TO = 0x00000080
IN_CREATE = 0x00000100
IN_CLOEXEC = 0o2000000
_EVENT_HDR = struct.Struct("iIII")


class Inotify:
    def __init__(self) -> None:
        self._libc = ctypes.CDLL("libc.so.6", use_errno=True)
        self._libc.inotify_init1.argtypes = [ctypes.c_int]
        self._libc.inotify_add_watch.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_uint32]
        fd = self._libc.inotify_init1(IN_CLOEXEC)
        if fd < 0:
            raise OSError(ctypes.get_errno(), "inotify_init1 failed")
        self.fd = fd
        self._watches: dict[int, str] = {}

    def add(self, path: str, mask: int) -> None:
        wd = self._libc.inotify_add_watch(self.fd, path.encode(), mask)
        if wd >= 0:
            self._watches[wd] = path

    def read_events(self):
        data = os.read(self.fd, 8192)
        off = 0
        while off + _EVENT_HDR.size <= len(data):
            wd, _mask, _cookie, nlen = _EVENT_HDR.unpack_from(data, off)
            off += _EVENT_HDR.size
            name = data[off: off + nlen].split(b"\0", 1)[0].decode("utf-8", "replace")
            off += nlen
            path = self._watches.get(wd)
            if path is not None:
                yield path, name

    def close(self) -> None:
        try:
            os.close(self.fd)
        except OSError:
            pass


# --------------------------------------------------------------------------
# The listener
# --------------------------------------------------------------------------

DEBOUNCE_EVENT = "activewindowv2"


class Narrator:
    """Decides whether a journalled event is worth saying, and in what words.

    Three steps, in order, each of which can end in silence:

      1. Is this kind of event narratable at the current verbosity?
      2. Is it interesting enough, given everything already said? (the shared
         scorer, plus the gain controller that holds the overall rate near
         `target_rate` — see bin/prometheus-attention)
      3. Is there a phrasing for the *moment* it represents?

    Step 3 is the part that makes docs/08's "second axis" real. The scorer
    doesn't just hand back a probability, it hands back *why* the event was
    interesting, and that reason selects which moment fires: a first sighting
    today draws from `app_first_today`, a return after an absence from
    `app_returned`, a rarely-touched app from `app_rare`. Twelve phrasings
    across five distinguishable moments is far less predictable than forty of
    one, and — more to the point — each one is true of the specific event.

    Never blocks. The socket write is fire-and-forget with a short timeout
    (docs/07 rule 5: "no producer blocks"), and every failure path here is a
    silence, never an exception into the event loop.
    """

    # Which phrasebank moment a scored event becomes. Order matters — the
    # first matching reason wins, most-specific first, so an app you have not
    # touched in weeks that you also open at 2am is reported as rare rather
    # than as late, because rarity is the more interesting of the two.
    REASON_MOMENTS = (
        ("rare", "app_rare"),
        ("novel-today", "app_first_today"),
        ("returned", "app_returned"),
        ("long-dwell", "app_returned"),
        ("odd-hour", "app_odd_hour"),
    )

    def __init__(self, cfg: dict) -> None:
        self.cfg = cfg
        self.bank = None
        self.scorer = None
        self.gate = None
        self.control = None
        self._rnd = random.Random()
        self.stats = {"scored": 0, "spoke": 0, "quiet": 0, "no_phrasing": 0,
                      "gated_verbosity": 0, "gated_no_reason": 0,
                      "seeded_from_journal": 0}
        self.configure(cfg)

    def configure(self, cfg: dict) -> None:
        """(Re)read config. Called on every hot-reload.

        The scorer's accumulated history deliberately survives a reload —
        editing a weight should change what happens next, not amnesia about
        which apps you have already used today.
        """
        self.cfg = cfg
        self.enabled = bool(ATTN) and bool(
            (cfg.get("speak", {}).get("desktop_activity", {}) or {}).get("enabled", True))
        if not ATTN:
            return
        self.attn = ATTN.attention_from_config(cfg)
        self.target_rate = ATTN.target_rate_from_config(cfg)
        self.require_reason = ATTN.require_reason_kinds(cfg)
        if self.scorer is None:
            self.scorer = ATTN.Scorer(self.attn)
            seeded = self.scorer.seed_from_journal(JOURNAL_PATH)
            self.stats["seeded_from_journal"] = seeded
            LOG.info("narrate.seeded",
                     "absorbed today's journal so a restart isn't amnesia",
                     events=seeded or None)
            self.gate = ATTN.Gate(self.attn)
            self.control = ATTN.RateController(self.attn, self.target_rate, GAIN_FILE)
        else:
            self.scorer.attn = self.attn
            self.gate.attn = self.attn
            self.control.attn = self.attn
            self.control.target = self.target_rate
        if self.bank is None and PB is not None:
            try:
                self.bank = PB.Bank.open(cfg)
            except (OSError, ValueError, KeyError, AttributeError) as e:
                LOG.warn("narrate.no_bank", str(e))

    def verbosity(self) -> str:
        """Read live, not cached: SUPER+ALT+V writes this file mid-session."""
        try:
            with open(os.path.join(STATE_DIR, "verbosity")) as f:
                v = f.read().strip()
            return v if v in ATTN.VERBOSITY_KINDS else "normal"
        except OSError:
            return self.cfg.get("verbosity", "normal")

    def moment_for(self, kind: str, reasons: list[str]) -> str | None:
        if kind == "workspace":
            return "workspace_switched"
        if kind == "open":
            return "app_opened"
        if kind in ("focus", "fullscreen", "close"):
            for reason, moment in self.REASON_MOMENTS:
                if any(r.startswith(reason) for r in reasons):
                    return moment
            # A focus change with nothing notable about it is the case
            # docs/06 principle 6 is about — he knows he just switched
            # windows. `app_returned` is the mildest thing in the bank that
            # is still true of it.
            return "app_returned"
        return None

    def slots_for(self, moment: str, app: str, event: dict) -> dict:
        if moment == "workspace_switched":
            return {"workspace": event.get("name") or event.get("id") or "another"}
        return {"app": app}

    def consider(self, kind: str, app: str, event: dict, coalesced: int = 0) -> None:
        """Score one event and speak it, or don't. Called once per journal write."""
        if not self.enabled or self.scorer is None:
            return
        now = time.time()

        # Feed the scorer everything, narrate only what this tier allows.
        # Verbosity is about what it talks about, not what it knows: a focus
        # change still counts as activity for "returned after an absence" even
        # at `quiet`, where focus changes are never spoken.
        scored = self.scorer.score(now, kind, app, coalesced)
        if kind not in ATTN.kinds_for_verbosity(self.verbosity(), self.cfg):
            self.stats["gated_verbosity"] += 1
            return

        # Some kinds never speak on a bare draw — see DEFAULT_REQUIRE_REASON.
        if kind in self.require_reason and not ATTN.meaningful_reasons(scored["reasons"]):
            self.stats["gated_no_reason"] += 1
            LOG.debug("narrate.no_reason", app, kind=kind)
            return

        self.stats["scored"] += 1
        prob, gate = self.gate.apply(now, app, self.control.probability(scored["raw"]))
        spoke = self._rnd.random() < prob

        LOG.debug("narrate.scored", app, kind=kind, raw=round(scored["raw"], 3),
                  prob=round(prob, 4), gate=gate, k=round(self.control.k, 3),
                  reasons=",".join(scored["reasons"]) or None,
                  decision="speak" if spoke else "quiet")

        # The controller learns from every eligible event, spoken or not —
        # that ratio *is* the achieved rate it steers on.
        self.control.observe(spoke)

        if not spoke:
            self.stats["quiet"] += 1
            return

        moment = self.moment_for(kind, scored["reasons"])
        text = None
        if moment and self.bank is not None:
            try:
                text = self.bank.pick(moment, self.slots_for(moment, app, event))
            except (OSError, ValueError, KeyError, AttributeError) as e:
                LOG.warn("narrate.pick_failed", str(e), moment=moment)
        if not text:
            # No phrasing is a silence, not a fallback. A hand-rolled default
            # here would be the one sentence in the system that never varies,
            # which is precisely what ADR-0004 exists to prevent.
            self.stats["no_phrasing"] += 1
            LOG.debug("narrate.no_phrasing", moment or kind)
            return

        self.gate.record_spoken(now, app)
        self.stats["spoke"] += 1
        LOG.info("narrate.speak", text, moment=moment, app=app,
                 reasons=",".join(scored["reasons"]) or None)
        self.send(text, moment)

    def send(self, text: str, moment: str) -> None:
        intent = {
            "text": text,
            "priority": "ambient",
            "category": "hypr",
            # Ambient remarks are about *now*. One that waited behind a long
            # utterance is describing a window you already left, so it expires
            # rather than arriving late and wrong.
            "ttl_ms": 8000,
            "dedup_key": f"hypr:{moment}",
        }
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.settimeout(0.5)
            s.connect(SOCK_PATH)
            s.sendall(json.dumps(intent).encode() + b"\n")
            s.close()
        except OSError as e:
            LOG.debug("narrate.unreachable", str(e))


class Listener:
    def __init__(self) -> None:
        self.cfg = load_config()
        LOG.configure(self.cfg)
        self.journal = Journal()
        self.journal.configure(self.cfg)
        self._apply_hypr_cfg()

        self.windows: dict[str, str] = {}      # address -> class
        self.current_addr: str | None = None
        self.pending_focus: dict | None = None  # {"address", "count", "deadline"}
        self.pending_workspace: dict | None = None  # {"id","name","count","deadline"}
        self._unknown_seen: set[str] = set()
        self._last_workspace: tuple | None = None
        self._last_monitor: tuple | None = None

        self.narrator = Narrator(self.cfg)

        self.stats = {"dropped_title": 0, "focus_settled": 0, "unknown_classes": 0,
                      "workspace_settled": 0, "workspace_coalesced": 0}

        self._sock: socket.socket | None = None
        self._buf = bytearray()

    def _apply_hypr_cfg(self) -> None:
        h = self.cfg.get("hypr", {})
        self.debounce_secs = float(h.get("debounce_secs", 1.5))
        self.workspace_settle_secs = float(
            h.get("workspace_settle_secs", max(2.0, self.debounce_secs)))
        self.app_names: dict[str, str] = dict(h.get("app_names", {}))

    # -- seeding --------------------------------------------------------

    def seed_windows(self) -> None:
        """Pre-populate the address->class map from windows already open,
        so activewindowv2 right after (re)start can resolve a class instead
        of a dead lookup."""
        try:
            out = subprocess.run(["hyprctl", "clients", "-j"], capture_output=True,
                                  text=True, timeout=5).stdout
            for c in json.loads(out):
                # hyprctl's JSON addresses are "0x"-prefixed; the raw event
                # socket's addresses are not (confirmed live). Normalize to
                # the socket's form so lookups from either source agree.
                addr = c.get("address")
                cls = c.get("class")
                if addr and cls:
                    self.windows[addr.removeprefix("0x")] = cls
            active = subprocess.run(["hyprctl", "activewindow", "-j"],
                                    capture_output=True, text=True, timeout=5).stdout
            aw = json.loads(active) if active.strip() else {}
            addr = aw.get("address")
            self.current_addr = addr.removeprefix("0x") if addr else None
        except (OSError, ValueError, subprocess.SubprocessError) as e:
            LOG.warn("hypr.seed_failed", str(e))

    # -- connection -------------------------------------------------------

    def connect(self) -> None:
        if not HYPR_SOCK:
            LOG.error("hypr.no_signature", "HYPRLAND_INSTANCE_SIGNATURE is unset — not running under Hyprland?")
            raise SystemExit(1)
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.connect(HYPR_SOCK)
        s.setblocking(False)
        self._sock = s
        LOG.info("hypr.connected", socket=HYPR_SOCK)

    # -- event dispatch -----------------------------------------------------

    def handle_line(self, text: str) -> None:
        ev, sep, data = text.partition(">>")
        if not sep:
            return
        if ev in ("windowtitle", "windowtitlev2"):
            # The concrete bug (docs/00-feasibility.md): titles animate
            # several times a second. Never parsed, never journaled.
            self.stats["dropped_title"] += 1
            return
        if ev == "activewindowv2":
            self._on_activewindow(data.strip())
        elif ev == "openwindow":
            self._on_openwindow(data)
        elif ev == "closewindow":
            self._on_closewindow(data.strip())
        elif ev == "workspacev2":
            self._on_workspace(data)
        elif ev == "workspace" and self._last_workspace is None:
            # Fallback only: workspacev2 supersedes this on modern Hyprland.
            # If v2 never arrives (older build), don't stay silent forever.
            self._on_workspace_legacy(data)
        elif ev == "fullscreen":
            self._on_fullscreen(data.strip())
        elif ev == "focusedmon":
            self._on_monitor(data)
        # activewindow (v1), movewindow, urgent, etc: not tracked in Phase 1.

    def _on_activewindow(self, addr: str) -> None:
        if not addr:
            return
        # Empirically, a window with an animating title (this very Claude
        # Code session mid-turn) re-fires activewindowv2 on every title
        # change, not just windowtitlev2. A repeat of the address already
        # pending or already settled changes nothing and must NOT push the
        # debounce deadline out, or a long-spinning title would hold focus
        # settlement open indefinitely.
        if self.pending_focus and self.pending_focus["address"] == addr:
            self.pending_focus["dupes"] += 1
            return
        if addr == self.current_addr and self.pending_focus is None:
            return
        now = time.monotonic()
        prev_count = self.pending_focus["count"] if self.pending_focus else 0
        self.pending_focus = {
            "address": addr,
            "count": prev_count + 1,
            "dupes": 0,
            "deadline": now + self.debounce_secs,
        }

    def settle_focus(self) -> None:
        pf = self.pending_focus
        self.pending_focus = None
        if pf is None:
            return
        addr = pf["address"]
        self.current_addr = addr
        cls = self.windows.get(addr)
        name = self.app_names.get(cls) if cls else None
        self.stats["focus_settled"] += 1
        if not name:
            if cls:
                self._note_unknown(cls)
            return
        coalesced = pf["count"] if pf["count"] > 1 else None
        self.journal.write("focus", cls=cls, name=name, coalesced=coalesced)
        LOG.debug("hypr.focus", name, cls=cls, coalesced=pf["count"])
        self.narrator.consider("focus", name, {"cls": cls}, pf["count"])

    def _on_openwindow(self, data: str) -> None:
        parts = data.split(",", 3)
        if len(parts) < 3:
            return
        addr, _workspace, cls = parts[0], parts[1], parts[2]
        self.windows[addr] = cls
        name = self.app_names.get(cls)
        if not name:
            self._note_unknown(cls)
            return
        self.journal.write("open", cls=cls, name=name)
        LOG.debug("hypr.open", name, cls=cls)
        self.narrator.consider("open", name, {"cls": cls})

    def _on_closewindow(self, addr: str) -> None:
        cls = self.windows.pop(addr, None)
        if self.pending_focus and self.pending_focus["address"] == addr:
            self.pending_focus = None
        if addr == self.current_addr:
            self.current_addr = None
        name = self.app_names.get(cls) if cls else None
        if not name:
            return
        self.journal.write("close", cls=cls, name=name)
        LOG.debug("hypr.close", name, cls=cls)
        # Deliberately journalled but never narrated: docs/06 lists "app
        # closed" as one of the events that says nothing, because closing a
        # window is intentional and you were there when it happened.

    def _on_workspace(self, data: str) -> None:
        wid, _, wname = data.partition(",")
        self._queue_workspace(wid or None, wname or None)

    def _on_workspace_legacy(self, data: str) -> None:
        self._queue_workspace(None, data.strip() or None)

    def _queue_workspace(self, wid: str | None, wname: str | None) -> None:
        """Hold a workspace switch open until the flicking stops.

        Mirrors the focus debounce, and for the same reason measured on real
        data: 54% of workspace switches in the Phase 5 journal arrived within
        two seconds of the one before. Journalling each one made the busiest
        event class also the least filtered.

        As with focus, a repeat of the destination already pending must not
        push the deadline out — holding SUPER and walking across five
        workspaces should settle once, on the fifth.
        """
        key = (wid, wname)
        if self.pending_workspace is not None:
            if self.pending_workspace["key"] != key:
                self.stats["workspace_coalesced"] += 1
            self.pending_workspace["key"] = key
            self.pending_workspace["count"] += 1
            return
        if key == self._last_workspace:
            return
        self.pending_workspace = {
            "key": key,
            "count": 1,
            "deadline": time.monotonic() + self.workspace_settle_secs,
        }

    def settle_workspace(self) -> None:
        pw = self.pending_workspace
        self.pending_workspace = None
        if pw is None:
            return
        key = pw["key"]
        if key == self._last_workspace:
            # Flicked out and back again — you ended where you started, so
            # nothing happened worth recording.
            return
        self._last_workspace = key
        wid, wname = key
        count = pw["count"]
        self.stats["workspace_settled"] += 1
        self.journal.write("workspace", id=wid, name=wname,
                           coalesced=count if count > 1 else None)
        LOG.debug("hypr.workspace", wname or wid, coalesced=count)
        self.narrator.consider("workspace", f"workspace {wname or wid}",
                               {"id": wid, "name": wname}, count)

    def _on_fullscreen(self, state: str) -> None:
        cls = self.windows.get(self.current_addr) if self.current_addr else None
        name = self.app_names.get(cls) if cls else None
        self.journal.write("fullscreen", state=state, cls=cls, name=name)
        LOG.debug("hypr.fullscreen", name or cls or "", state=state)
        # Entering fullscreen is a request to be left alone — docs/06 has it
        # saying nothing, and docs/04 task 5.4 makes it a gate on everything
        # else too (enforced in prometheusd, which sees all speech, not just
        # this producer's).

    def _on_monitor(self, data: str) -> None:
        mon, _, ws = data.partition(",")
        key = (mon, ws)
        if key == self._last_monitor:
            return
        self._last_monitor = key
        self.journal.write("monitor", monitor=mon or None, workspace=ws or None)
        LOG.debug("hypr.monitor", mon, workspace=ws or None)

    def _note_unknown(self, cls: str) -> None:
        if cls in self._unknown_seen:
            return
        self._unknown_seen.add(cls)
        self.stats["unknown_classes"] += 1
        LOG.debug("hypr.unknown_class",
                  "not in hypr.app_names — add it to journal this class", cls=cls)

    # -- config reload --------------------------------------------------

    def reload_config(self) -> None:
        self.cfg = load_config()
        LOG.configure(self.cfg)
        self.journal.configure(self.cfg)
        self._apply_hypr_cfg()
        self.narrator.configure(self.cfg)
        LOG.info("hypr.config_reloaded", path=CONFIG_FILE, app_names=len(self.app_names),
                 narrating=self.narrator.enabled)

    # -- settle deadlines -------------------------------------------------

    def _next_deadline(self) -> float | None:
        """Earliest pending settle deadline, or None if nothing is pending.

        Two independent debounces now share one event loop, so the select()
        timeout is the nearer of the two rather than focus's alone. Getting
        this wrong is silent: a workspace switch would sit in `pending` until
        some unrelated event happened to wake the loop.
        """
        deadlines = [p["deadline"] for p in (self.pending_focus, self.pending_workspace)
                     if p is not None]
        return min(deadlines) if deadlines else None

    def _settle_due(self) -> None:
        now = time.monotonic()
        if self.pending_focus is not None and now >= self.pending_focus["deadline"]:
            self.settle_focus()
        if self.pending_workspace is not None and now >= self.pending_workspace["deadline"]:
            self.settle_workspace()

    # -- main loop --------------------------------------------------------

    def run(self) -> int:
        self.connect()
        self.seed_windows()

        ino = Inotify()
        os.makedirs(CONFIG_DIR, exist_ok=True)
        ino.add(CONFIG_DIR, IN_CLOSE_WRITE | IN_MOVED_TO | IN_CREATE)

        sel = selectors.DefaultSelector()
        sel.register(self._sock, selectors.EVENT_READ, "hypr")
        sel.register(ino.fd, selectors.EVENT_READ, "inotify")

        # A bare `shutdown["flag"] = True` in the signal handler is not
        # enough: `sel.select(timeout=None)` blocks in the kernel, and PEP
        # 475 makes Python transparently retry a syscall interrupted by a
        # signal rather than returning — so with nothing else, SIGTERM would
        # never be noticed while idle, and systemd would have to wait out
        # the stop timeout and SIGKILL it. (Confirmed live: `prometheus off`
        # left this process in `deactivating`/`stop-sigterm` for the full
        # timeout.) The standard fix is a self-pipe: `set_wakeup_fd` writes a
        # byte to it on every signal, and having that fd registered with the
        # selector makes `select()` return immediately.
        wake_r, wake_w = os.pipe()
        os.set_blocking(wake_r, False)
        os.set_blocking(wake_w, False)
        signal.set_wakeup_fd(wake_w)
        sel.register(wake_r, selectors.EVENT_READ, "wake")

        LOG.info("hypr.ready",
                 "journaling and narrating" if self.narrator.enabled
                 else "journaling filtered Hyprland events",
                 journal=self.journal.path, debounce_secs=self.debounce_secs,
                 workspace_settle_secs=self.workspace_settle_secs,
                 tracked_classes=len(self.app_names), narrating=self.narrator.enabled,
                 target_rate=self.narrator.target_rate if self.narrator.enabled else None,
                 gain=round(self.narrator.control.k, 3) if self.narrator.enabled else None,
                 pid=os.getpid())

        shutdown = {"flag": False}

        def on_term(_signum, _frame):
            shutdown["flag"] = True

        signal.signal(signal.SIGTERM, on_term)
        signal.signal(signal.SIGINT, on_term)
        signal.signal(signal.SIGUSR1,
                      lambda *_: LOG.info("hypr.stats", **self.stats,
                                          **self.narrator.stats))

        while not shutdown["flag"]:
            deadline = self._next_deadline()
            timeout = None if deadline is None else max(0.0, deadline - time.monotonic())
            try:
                events = sel.select(timeout=timeout)
            except OSError as e:
                if e.errno == errno.EINTR:
                    continue
                break

            if not events and deadline is not None:
                self._settle_due()
                continue

            for key, _mask in events:
                if key.data == "hypr":
                    try:
                        chunk = self._sock.recv(65536)
                    except BlockingIOError:
                        continue
                    except OSError:
                        chunk = b""
                    if not chunk:
                        LOG.error("hypr.disconnected", "Hyprland closed the socket; exiting for systemd to restart")
                        return 1
                    self._buf.extend(chunk)
                    while b"\n" in self._buf:
                        line, _, rest = self._buf.partition(b"\n")
                        self._buf = bytearray(rest)
                        text = line.decode("utf-8", "replace").strip()
                        if text:
                            self.handle_line(text)
                elif key.data == "inotify":
                    for path, name in ino.read_events():
                        if path == CONFIG_DIR and name == "config.json":
                            self.reload_config()
                elif key.data == "wake":
                    try:
                        os.read(wake_r, 4096)
                    except BlockingIOError:
                        pass

            # A settle deadline may have passed while handling I/O above.
            self._settle_due()

        LOG.info("hypr.stopping", **self.stats, **self.narrator.stats)
        signal.set_wakeup_fd(-1)
        os.close(wake_r)
        os.close(wake_w)
        ino.close()
        return 0


def main() -> int:
    os.makedirs(STATE_DIR, exist_ok=True)
    return Listener().run()


if __name__ == "__main__":
    sys.exit(main())
