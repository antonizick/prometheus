#!/usr/bin/env python3
"""prometheus-llm — local-LLM summarizer wrapper (Phase 2, tasks 2.5-2.7).

  prometheus-llm summarize [--category CAT]     text read from stdin
  prometheus-llm summarize --raw                also print the model's
                                                 unfiltered output, to stderr
  prometheus-llm brief                          synthesise an event digest
                                                 (task 2.7; `prometheus brief`)

Sends stdin (a command's output tail, or an assistant message) to the
runtime model configured in config.json's "llm" block, using the
persona.md + about-me.md prompt from docs/03-model-selection.md, and prints
a cleaned, speakable summary to stdout — or nothing at all.

Nothing is ever the correct output on failure. A caller (a shell hook, a
Claude Code hook) must never be blocked or broken by this: not by Ollama
being down, not by a slow model, not by a model that ignores instructions.
Every path below either produces a clean sentence or produces silence —
never an exception, a hang past `llm.timeout_secs`, or raw model text.

Ollama is never resident unless something is actively summarizing
(docs/07-resource-profile.md, "the GPU must not be held hostage"): this
wrapper starts prometheus-ollama.service on first use if it isn't already
up, and relies on that unit's OLLAMA_KEEP_ALIVE (5m) to release VRAM
automatically afterwards. It never sets keep_alive to -1 and never touches
the pacman-shipped, disabled `ollama.service`.

Every call is logged to ~/.local/state/prometheus/prometheus-llm.log —
outcome, reason, and a preview of the input and output — whether or not the
summary was ultimately spoken. That log is the evidence base for tuning the
prompt and for catching a model that starts reporting outcomes backwards.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import socket
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request

HOME = os.path.expanduser("~")
CONFIG_DIR = os.environ.get("PROMETHEUS_CONFIG_DIR") or os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or f"{HOME}/.config", "prometheus"
)
STATE_DIR = os.environ.get("PROMETHEUS_STATE_DIR") or os.path.join(
    os.environ.get("XDG_STATE_HOME") or f"{HOME}/.local/state", "prometheus"
)
CONFIG_FILE = os.path.join(CONFIG_DIR, "config.json")
OLLAMA_UNIT = "prometheus-ollama.service"

DEFAULT_CONFIG = {
    "log_level": "info",
    "logging": {"file_enabled": True, "file_level": "debug", "max_bytes": 4194304},
    "limits": {"max_words_summary": 30, "max_words_brief": 45},
    "identity": {"name": "Prometheus"},
    "llm": {
        "runtime_model": "qwen3:4b-instruct",
        "authoring_model": "qwen3:8b",
        "keep_alive": "5m",
        "timeout_secs": 4,
        "temperature": 0.7,
        "num_predict": 60,
        "host": "127.0.0.1:11434",
        # How long to wait for prometheus-ollama.service's socket to accept
        # connections after an on-demand `systemctl --user start`. Separate
        # from timeout_secs, which bounds the generate call itself (model
        # load included — Ollama loads lazily on first request).
        "server_start_wait_secs": 2.0,
        # A briefing was asked for, so a second or two of waiting is fine where
        # it would not be for an unprompted remark. Still bounded: the model
        # loading cold is the slow case, and silence is still the fallback.
        "brief_timeout_secs": 12,
        "brief_num_predict": 110,
    },
}

INSTRUCTIONS_TMPL = """You narrate a developer's computer out loud. You will be given the output
of a command or an AI assistant's message.

Reply with at most two short sentences describing the outcome, written to be
spoken aloud. Keep it under {max_words} words.

Never use: lists, bullet points, markdown, file paths, function names,
code, or identifiers. Say "the auth middleware", not "src/auth/mw.ts".
Never begin with "Here is" or "The output shows". State the outcome directly.
If nothing noteworthy happened, reply exactly: NOTHING"""

# The briefing is a different job from summarizing one command's output
# (docs/03: "Multi-event briefing | Local LLM | Genuine synthesis task"), and
# it is PULLED — he pressed the key and is listening — so it may run longer
# than the fifteen-word ceiling on anything unprompted (docs/06).
#
# The input is a digest this system built from its own journal, so every fact
# in it is already true. The model's entire job is to say it like a person
# would; it must never add anything that isn't in the digest.
BRIEF_INSTRUCTIONS_TMPL = """You are being handed a digest of what has happened on this computer since the
last briefing. It was asked for, out loud, just now.

Say it back as one spoken paragraph — at most {max_words} words, two or three
sentences. This is someone looking up from their work and asking "what have I
been doing", so answer that, in that register.

Use only what the digest says. Never add a fact, a cause, a judgement or a
guess. Never read out numbers that don't change anything — "a few times" beats
"four times" unless the count is the point.

Write every number and unit the way you would SAY it. "nine minutes", never
"9min". "a minute and a half", never "81s". No abbreviations of any kind.

Never use: lists, bullet points, markdown, file paths, or code. Never begin
with "Here is", "In the last", "You have" or "The digest". Start with what
actually happened.

If the digest is empty or says nothing happened, reply exactly: NOTHING"""


# --------------------------------------------------------------------------
# config + logging (same shape as bin/prometheusd, bin/prometheus-hypr)
# --------------------------------------------------------------------------

def deep_merge(base: dict, over: dict) -> dict:
    out = dict(base)
    for k, v in (over or {}).items():
        if isinstance(v, dict) and isinstance(out.get(k), dict):
            out[k] = deep_merge(out[k], v)
        else:
            out[k] = v
    return out


def strip_jsonc(text: str) -> str:
    out, in_str, esc, i = [], False, False, 0
    while i < len(text):
        c = text[i]
        if in_str:
            out.append(c)
            if esc:
                esc = False
            elif c == "\\":
                esc = True
            elif c == '"':
                in_str = False
        elif c == '"':
            in_str = True
            out.append(c)
        elif c == "/" and i + 1 < len(text) and text[i + 1] == "/":
            while i < len(text) and text[i] != "\n":
                i += 1
            continue
        else:
            out.append(c)
        i += 1
    return "".join(out)


def load_config() -> dict:
    try:
        with open(CONFIG_FILE) as f:
            raw = json.loads(strip_jsonc(f.read()))
    except FileNotFoundError:
        return dict(DEFAULT_CONFIG)
    except (OSError, ValueError):
        return dict(DEFAULT_CONFIG)
    return deep_merge(DEFAULT_CONFIG, raw)


LEVELS = {"debug": 0, "info": 1, "warn": 2, "error": 3}


class Log:
    def __init__(self) -> None:
        self.level = LEVELS["info"]
        self.file_level = LEVELS["debug"]
        # Sane default so a crash before configure() (e.g. config.json itself
        # is broken) still lands somewhere instead of vanishing.
        self.file_path: str | None = os.path.join(STATE_DIR, "prometheus-llm.log")
        self.max_bytes = 4 * 1024 * 1024
        self._lock = threading.Lock()

    def configure(self, cfg: dict) -> None:
        lg = cfg.get("logging", {})
        self.level = LEVELS.get(cfg.get("log_level", "info"), LEVELS["info"])
        self.file_level = LEVELS.get(lg.get("file_level", "debug"), LEVELS["debug"])
        self.max_bytes = int(lg.get("max_bytes", 4 * 1024 * 1024))
        self.file_path = (
            os.path.join(STATE_DIR, "prometheus-llm.log") if lg.get("file_enabled", True) else None
        )

    def emit(self, level: str, event: str, msg: str = "", **fields) -> None:
        lv = LEVELS[level]
        now = time.time()
        if lv >= self.level and sys.stderr.isatty():
            parts = " ".join(f"{k}={v}" for k, v in fields.items() if v is not None)
            line = f"{time.strftime('%H:%M:%S', time.localtime(now))} {level.upper():<5} {event}"
            if msg:
                line += f": {msg}"
            if parts:
                line += "  " + parts
            print(line, file=sys.stderr)
        if lv >= self.file_level and self.file_path:
            rec = {"t": round(now, 3), "level": level, "event": event}
            if msg:
                rec["msg"] = msg
            rec.update({k: v for k, v in fields.items() if v is not None})
            with self._lock:
                try:
                    os.makedirs(os.path.dirname(self.file_path), exist_ok=True)
                    with open(self.file_path, "a") as f:
                        f.write(json.dumps(rec, default=str) + "\n")
                        if f.tell() >= self.max_bytes:
                            os.replace(self.file_path, self.file_path + ".1")
                except OSError:
                    pass

    def debug(self, event, msg="", **f): self.emit("debug", event, msg, **f)
    def info(self, event, msg="", **f): self.emit("info", event, msg, **f)
    def warn(self, event, msg="", **f): self.emit("warn", event, msg, **f)
    def error(self, event, msg="", **f): self.emit("error", event, msg, **f)


LOG = Log()


def preview(text: str, n: int = 120) -> str:
    text = " ".join(text.split())
    return text if len(text) <= n else text[:n] + "…"


# --------------------------------------------------------------------------
# prompt
# --------------------------------------------------------------------------

def read_text_file(path: str) -> str:
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return ""


def build_system_prompt(max_words: int, cfg: dict, template: str = INSTRUCTIONS_TMPL) -> str:
    # docs/08: from Phase 2 the name is injected into persona prompts, so the
    # system refers to *itself* by the configured name rather than just being
    # labelled with it.
    name = (cfg.get("identity") or {}).get("name") or "Prometheus"
    persona = read_text_file(os.path.join(CONFIG_DIR, "persona.md")).replace("{{name}}", name)
    about_me = read_text_file(os.path.join(CONFIG_DIR, "about-me.md")).replace("{{name}}", name)
    instructions = template.format(max_words=max_words)
    return "\n\n".join(p for p in (persona, about_me, instructions) if p)


# --------------------------------------------------------------------------
# post-filter — never trust the model to have obeyed (docs/03)
# --------------------------------------------------------------------------

NOTHING_RE = re.compile(r"\bNOTHING\b", re.IGNORECASE)
CODE_FENCE_RE = re.compile(r"```.*?```", re.DOTALL)
BACKTICK_RE = re.compile(r"`([^`]*)`")
LIST_MARKER_RE = re.compile(r"(?m)^\s*(?:[-*•]|\d+[.)])\s+")
PATH_TOKEN_RE = re.compile(
    r"(?:[~.]?/[\w.\-]+){1,}(?:/[\w.\-]+)*"  # /a/b, ~/a/b, ./a
    r"|\b[\w\-]+\.(?:py|js|ts|jsx|tsx|json|md|c|h|cpp|sh|rs|go|toml|yaml|yml|cfg|ini|log)\b"
)
BANNED_OPENERS = (
    "here is", "here's", "here are",
    "the output shows", "the output indicates", "the output says",
)


def post_filter(raw: str, max_words: int) -> str | None:
    if not raw or not raw.strip():
        return None
    text = raw.strip()
    if NOTHING_RE.search(text):
        return None  # the escape hatch — docs/03: "any response containing
                     # NOTHING is silently dropped", verbatim, no exceptions

    text = CODE_FENCE_RE.sub(" ", text)
    text = BACKTICK_RE.sub(r"\1", text)  # keep the word, drop the code marker
    text = LIST_MARKER_RE.sub("", text)
    text = PATH_TOKEN_RE.sub("", text)
    text = re.sub(r"\s+", " ", text).strip()

    low = text.lower()
    for opener in BANNED_OPENERS:
        if low.startswith(opener):
            text = text[len(opener):].lstrip(" :,-")
            if text:
                text = text[0].upper() + text[1:]
            low = text.lower()
            break

    words = text.split()
    if len(words) > max_words:
        text = " ".join(words[:max_words])

    return text or None


# --------------------------------------------------------------------------
# ollama transport — on-demand only, never always-on (docs/07)
# --------------------------------------------------------------------------

def port_open(host: str, port: int, timeout: float) -> bool:
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except OSError:
        return False


def ensure_ollama_up(host_port: str, wait_secs: float) -> bool:
    host, port = host_port.split(":")
    port = int(port)
    if port_open(host, port, 0.3):
        return True

    LOG.info("ollama.cold_start", "socket not open, starting on demand", unit=OLLAMA_UNIT)
    try:
        subprocess.run(
            ["systemctl", "--user", "start", OLLAMA_UNIT],
            timeout=wait_secs, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
    except (OSError, subprocess.TimeoutExpired) as e:
        LOG.warn("ollama.start_failed", str(e), unit=OLLAMA_UNIT)
        return False

    deadline = time.monotonic() + wait_secs
    while time.monotonic() < deadline:
        if port_open(host, port, 0.3):
            return True
        time.sleep(0.15)
    LOG.warn("ollama.unreachable", "socket never opened after start", waited_secs=wait_secs)
    return False


def generate(host_port: str, model: str, system: str, user: str,
             num_predict: int, temperature: float, keep_alive: str,
             timeout_secs: float) -> dict | None:
    body = {
        "model": model,
        "messages": [
            {"role": "system", "content": system},
            {"role": "user", "content": user},
        ],
        "stream": False,
        "think": False,  # no-op on non-thinking models; required on hybrid ones (docs/03)
        "keep_alive": keep_alive,
        "options": {"num_predict": num_predict, "temperature": temperature},
    }
    req = urllib.request.Request(
        f"http://{host_port}/api/chat",
        data=json.dumps(body).encode(),
        headers={"Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout_secs) as resp:
            return json.loads(resp.read())
    except (urllib.error.URLError, TimeoutError, socket.timeout, ValueError) as e:
        LOG.warn("generate.failed", str(e), model=model)
        return None


# --------------------------------------------------------------------------
# CLI
# --------------------------------------------------------------------------

def cmd_summarize(a: argparse.Namespace) -> int:
    cfg = load_config()
    LOG.configure(cfg)
    llm = cfg["llm"]
    max_words = cfg["limits"]["max_words_summary"]

    raw_input = sys.stdin.read()
    input_text = raw_input.strip()
    if not input_text:
        LOG.debug("summarize.empty_input")
        return 0

    t0 = time.monotonic()
    if not ensure_ollama_up(llm["host"], llm["server_start_wait_secs"]):
        LOG.info("summarize.dropped", "ollama unreachable, degrading to silence",
                  input=preview(input_text))
        return 0

    system_prompt = build_system_prompt(max_words, cfg)
    data = generate(
        llm["host"], llm["runtime_model"], system_prompt, input_text,
        llm["num_predict"], llm["temperature"], llm["keep_alive"],
        llm["timeout_secs"],
    )
    elapsed = round(time.monotonic() - t0, 3)

    if data is None:
        LOG.info("summarize.dropped", "generate call failed or timed out",
                  input=preview(input_text), elapsed_secs=elapsed,
                  category=a.category)
        return 0

    raw_reply = (data.get("message") or {}).get("content", "")
    if a.raw:
        print(f"[raw] {raw_reply}", file=sys.stderr)

    cleaned = post_filter(raw_reply, max_words)
    if cleaned is None:
        LOG.info("summarize.silent", "NOTHING or empty after post-filter",
                  input=preview(input_text), raw=preview(raw_reply),
                  elapsed_secs=elapsed, category=a.category)
        return 0

    LOG.info("summarize.ok", input=preview(input_text), output=cleaned,
              elapsed_secs=elapsed, category=a.category,
              model=llm["runtime_model"], word_count=len(cleaned.split()))
    print(cleaned)
    return 0


def cmd_brief(a: argparse.Namespace) -> int:
    """Task 2.7 — LLM synthesis of the event digest built by `prometheus brief`.

    Fail-silent like everything else here, with one difference that matters:
    the caller has a deterministic template it can speak instead, so silence
    from this path is a downgrade rather than a loss. A briefing was ASKED for,
    and answering nothing at all to a keypress is the one unacceptable outcome.
    """
    cfg = load_config()
    LOG.configure(cfg)
    llm = cfg["llm"]
    max_words = cfg["limits"].get("max_words_brief", 45)

    digest = sys.stdin.read().strip()
    if not digest:
        LOG.debug("brief.empty_input")
        return 0

    t0 = time.monotonic()
    if not ensure_ollama_up(llm["host"], llm["server_start_wait_secs"]):
        LOG.info("brief.dropped", "ollama unreachable, caller falls back to template",
                 input=preview(digest))
        return 0

    system_prompt = build_system_prompt(max_words, cfg, BRIEF_INSTRUCTIONS_TMPL)
    data = generate(
        llm["host"], llm["runtime_model"], system_prompt, digest,
        llm.get("brief_num_predict", 110), llm["temperature"], llm["keep_alive"],
        llm.get("brief_timeout_secs", 12),
    )
    elapsed = round(time.monotonic() - t0, 3)

    if data is None:
        LOG.info("brief.dropped", "generate call failed or timed out",
                 input=preview(digest), elapsed_secs=elapsed)
        return 0

    raw_reply = (data.get("message") or {}).get("content", "")
    if a.raw:
        print(f"[raw] {raw_reply}", file=sys.stderr)

    cleaned = post_filter(raw_reply, max_words)
    if cleaned is None:
        LOG.info("brief.silent", "NOTHING or empty after post-filter",
                 input=preview(digest), raw=preview(raw_reply), elapsed_secs=elapsed)
        return 0

    LOG.info("brief.ok", input=preview(digest, 300), output=cleaned,
             elapsed_secs=elapsed, model=llm["runtime_model"],
             word_count=len(cleaned.split()))
    print(cleaned)
    return 0


def main() -> int:
    p = argparse.ArgumentParser(prog="prometheus-llm")
    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("summarize", help="summarize stdin, print a clean sentence or nothing")
    sp.add_argument("-c", "--category", default=None, help="event category, for the log only")
    sp.add_argument("--raw", action="store_true", help="also print the model's unfiltered reply to stderr")
    sp.set_defaults(func=cmd_summarize)

    bp = sub.add_parser("brief", help="synthesise an event digest read from stdin")
    bp.add_argument("--raw", action="store_true",
                    help="also print the model's unfiltered reply to stderr")
    bp.set_defaults(func=cmd_brief)

    a = p.parse_args()
    try:
        return a.func(a)
    except Exception as e:
        # Fail-silent applies to crashes too — a producer must never see this
        # tool break a pipeline. Still logged, so it isn't invisible.
        LOG.error(f"{a.cmd}.crash", str(e))
        return 0


if __name__ == "__main__":
    sys.exit(main())
